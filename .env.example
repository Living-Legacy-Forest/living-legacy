# =============================================================================
# PUBLIC VARS — exposed to the client bundle (safe to be public)
# =============================================================================

# HubSpot — portal ID used in embed scripts
PUBLIC_HUBSPOT_PORTAL_ID=

# Google tag / Google Ads, comma-separated. Live values: GT-KVFLGVB,AW-621100887
PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager. Live value: GTM-T7769GVH
PUBLIC_GTM_ID=

# Meta (Facebook) pixel. Live value: 2198197110470347
PUBLIC_META_PIXEL_ID=

# PostHog — product analytics + error tracking.
# Project API key (phc_...) is write-only and safe to expose. Leave blank to
# disable PostHog entirely; the client bundle is then never loaded.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cloudinary — cloud name used by the client-side URL builder
PUBLIC_CLOUDINARY_CLOUD_NAME=

# Sanity — used by generate-redirects script at build time
PUBLIC_SANITY_PROJECT_ID=6nf0cv12
PUBLIC_SANITY_DATASET=production

# Site environment: development | staging | production
PUBLIC_SITE_ENV=development


# =============================================================================
# PRIVATE VARS — server-only; never exposed to the client bundle
# =============================================================================

# Sanity
SANITY_PROJECT_ID=6nf0cv12
SANITY_DATASET=production
SANITY_API_VERSION=2026-05-25
# Editor token, only needed to run `pnpm blog:migrate --write`. Never commit it.
SANITY_WRITE_TOKEN=

# Cloudinary — server-side upload credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Eventbrite (optional)
EVENTBRITE_API_KEY=
EVENTBRITE_ORG_ID=
