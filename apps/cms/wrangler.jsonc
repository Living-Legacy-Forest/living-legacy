{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "living-legacy-cms",
  "main": "./src/server.ts",
  // Publishes scheduled posts. Times are UTC; every five minutes.
  "triggers": { "crons": ["*/5 * * * *"] },
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "living-legacy-db",
      "database_id": "6c172a87-78c0-4d32-b8b6-cf57324d1197",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // The MEDIA (R2) binding is added once the bucket exists; nothing reads it yet.
  "vars": {
    // Local dev overrides this with http://localhost:3100 in .dev.vars.
    "BETTER_AUTH_URL": "https://living-legacy-cms.living-legacy.workers.dev",
    // Magic-link sender. The domain must be verified in Resend.
    "EMAIL_FROM": "Living Legacy Forest <login@livinglegacyforest.com>"
  }
}
