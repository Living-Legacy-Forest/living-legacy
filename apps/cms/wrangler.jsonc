{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "living-legacy-cms",
  "main": "./src/server.ts",
  // Times are UTC. Every five minutes: publish scheduled posts. Daily at
  // 17:00 (early morning in Melbourne): delete stored files nothing uses
  // (src/server/media-sweep.ts). src/server.ts tells them apart by schedule.
  "triggers": { "crons": ["*/5 * * * *", "0 17 * * *"] },
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs, kept in Cloudflare and also sent to Better Stack (source
  // "Living Legacy CMS", US region) through the account's OpenTelemetry
  // destination of this name, which must exist before a deploy. Email
  // addresses are masked before anything is logged (src/lib/redact-console.ts).
  // Traces are kept in Cloudflare only; they have no destination. Sentry already
  // traces every request, so these are sampled at 10%, as a second view.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "destinations": ["betterstack-cms-logs"],
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  },
  "routes": [{ "pattern": "cms.livinglegacy.com.au", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "living-legacy-db",
      "database_id": "6c172a87-78c0-4d32-b8b6-cf57324d1197",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "living-legacy-media"
    }
  ],
  // Cloudflare Email Service sends every CMS email (src/lib/email.ts). The sender domain is onboarded
  // under Email Service > Email Sending. No "remote": local dev prints the link instead of sending.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // Local dev overrides this with http://localhost:3100 in .dev.vars.
    // Sign-in links and Google's callback are built from this, so it must be
    // the address people use; the workers.dev one redirects here (src/server.ts).
    "BETTER_AUTH_URL": "https://cms.livinglegacy.com.au",
    // Comma-separated. Each address can sign in as an Admin without an invite and is a super
    // admin (removes people, clears the activity log). Local dev reads its own from .dev.vars.
    "BOOTSTRAP_ADMIN_EMAILS": "gede@sistercreatives.co",
    // Sender for every CMS email (sign-in links, invites, review requests).
    // notify.livinglegacy.com.au is onboarded for Email Sending and kept apart from
    // the marketing mail sent from the root domain.
    "EMAIL_FROM": "Living Legacy CMS <cms@notify.livinglegacy.com.au>"
  }
}
