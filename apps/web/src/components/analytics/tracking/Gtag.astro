---
/**
 * gtag.js, shared by Google Analytics and Google Ads (one loader, one `dataLayer`, a `config`
 * call per id). The ids are split by what a visitor agrees to: Analytics ids (G-, UA-) wait for
 * analytics, Ads ids (AW-) wait for marketing. See GtagGroup.astro.
 *
 * Split out for the same reason as Gtm.astro: this renders unconditionally, and the parent decides
 * whether to include it. The conditionals below only ever wrap a component tag, because
 * prettier-plugin-astro cannot format a <script> nested in one.
 */
import { splitGaIds } from '@ll/content';
import GtagGroup from './GtagGroup.astro';

interface Props {
  ids: string[];
}

const { analytics, marketing } = splitGaIds(Astro.props.ids);
---

{analytics.length > 0 && <GtagGroup ids={analytics} category="analytics" />}
{marketing.length > 0 && <GtagGroup ids={marketing} category="marketing" />}
