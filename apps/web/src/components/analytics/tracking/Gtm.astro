---
/**
 * Google Tag Manager loader. Split out from Tracking.astro because
 * prettier-plugin-astro cannot format a <script> containing an object
 * literal when it's nested inside a `{condition && (...)}` expression; this
 * component instead renders unconditionally, and the parent decides whether
 * to include it at all.
 *
 * The loader waits as `text/plain` until ConsentGate runs it, once the visitor has said yes to
 * marketing. There is no no-JS fallback frame: it would load with no way to ask first.
 */
interface Props {
  gtmId: string;
}

const { gtmId } = Astro.props;
---

<script is:inline type="text/plain" data-consent="marketing" define:vars={{ gtmId }}>
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });

  const script = document.createElement('script');
  script.async = true;
  script.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;

  const firstScript = document.getElementsByTagName('script')[0];
  firstScript.parentNode?.insertBefore(script, firstScript);
</script>
