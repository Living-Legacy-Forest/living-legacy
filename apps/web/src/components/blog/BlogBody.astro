---
// Renders a post body. Both sources hand over ready HTML: the CMS renders its
// rich text through renderRichText (@ll/content), which escapes everything,
// and WordPress posts come from our own site with scripts stripped
// (src/lib/blog-wordpress.ts). The reading styles live in Prose.astro.
import Prose from '@/components/Prose.astro';

interface Props {
  html: string;
}

const { html } = Astro.props;
---

<Prose><Fragment set:html={html} /></Prose>
