---
// Renders a post body. Both sources hand over ready HTML: the CMS renders its
// rich text through renderRichText (@llf/content), which escapes everything,
// and WordPress posts come from our own site with scripts stripped
// (src/lib/blog-wordpress.ts). The styling uses the paper/moss/bark tokens
// from global.css and targets plain elements, since neither source adds
// classes of its own beyond WordPress's block wrappers.
interface Props {
  html: string;
}

const { html } = Astro.props;
---

<div class="pt" set:html={html} />

<style>
  /* Reading size: 18px on wide screens, easing down to 16px on a phone, with
     a looser leading than the site's base so long articles stay restful. */
  .pt {
    --pt-size: clamp(var(--text-base), 0.95rem + 0.3vw, 1.125rem);
    --pt-leading: 1.7;
  }

  .pt :global(h2),
  .pt :global(h3),
  .pt :global(h4) {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-ink);
    text-wrap: balance;
    /* Matches the sticky side columns' 7rem, clear of the sticky header. */
    scroll-margin-top: 7rem;
  }
  /* Each H2 opens a new section, so it gets clearly more room above than
     below: the space reads as a break, and the heading belongs to what
     follows it. */
  .pt :global(h2) {
    font-size: var(--text-2xl);
    line-height: var(--text-2xl--line-height);
    margin-top: 3.5rem;
    margin-bottom: 1rem;
  }
  .pt :global(h3) {
    font-size: var(--text-xl);
    line-height: var(--text-xl--line-height);
    margin-top: 2.25rem;
    margin-bottom: 0.625rem;
  }
  .pt :global(h4) {
    font-size: var(--text-lg);
    line-height: var(--text-lg--line-height);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .pt :global(h2:first-child),
  .pt :global(h3:first-child) {
    margin-top: 0;
  }

  .pt :global(p) {
    color: var(--color-ink);
    font-size: var(--pt-size);
    line-height: var(--pt-leading);
    margin-bottom: 1.375rem;
    text-wrap: pretty;
  }

  .pt :global(ul),
  .pt :global(ol) {
    color: var(--color-ink);
    padding-left: 1.5rem;
    margin-bottom: 1.375rem;
    font-size: var(--pt-size);
    line-height: var(--pt-leading);
  }
  .pt :global(ul) {
    list-style-type: disc;
  }
  .pt :global(ol) {
    list-style-type: decimal;
  }
  .pt :global(li) {
    margin-bottom: 0.375rem;
  }
  .pt :global(li::marker) {
    color: var(--color-moss);
  }

  .pt :global(blockquote) {
    border-left: 2px solid var(--color-moss);
    padding: 0.25rem 0 0.25rem 1.25rem;
    margin: 2rem 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--text-lg--line-height);
    color: var(--color-ink);
  }
  .pt :global(blockquote p) {
    margin-bottom: 0;
    color: inherit;
  }

  .pt :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }
  .pt :global(u),
  .pt :global(.pt-underline) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pt :global(a) {
    color: var(--color-moss-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s;
  }
  .pt :global(a:hover) {
    opacity: 0.75;
  }

  .pt :global(figure) {
    margin: 2rem 0;
  }
  .pt :global(figure img),
  .pt :global(p > img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0.75rem;
  }
  .pt :global(figcaption) {
    margin-top: 0.625rem;
    font-size: var(--text-xs);
    color: var(--color-bark);
    text-align: center;
  }

  .pt :global(.table-wrap),
  .pt :global(.wp-block-table) {
    overflow-x: auto;
    margin: 2rem 0;
    border: 1px solid color-mix(in oklab, var(--color-bark) 30%, transparent);
    border-radius: 0.75rem;
  }
  .pt :global(.wp-block-table table) {
    margin: 0;
  }
  .pt :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-base);
    line-height: var(--text-base--line-height);
  }
  .pt :global(th) {
    background-color: var(--color-paper-deep);
    color: var(--color-ink);
    font-weight: 600;
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-bark) 30%, transparent);
    white-space: nowrap;
  }
  .pt :global(td) {
    color: var(--color-ink);
    padding: 0.75rem 1rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-bark) 20%, transparent);
    vertical-align: top;
  }
  .pt :global(tbody tr:last-child td) {
    border-bottom: none;
  }

  .pt :global(.wp-block-embed__wrapper) {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    margin: 2rem 0;
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .pt :global(.wp-block-embed__wrapper iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .pt :global(hr) {
    margin: 2.5rem 0;
    border-color: color-mix(in oklab, var(--color-bark) 25%, transparent);
  }
  .pt :global(code) {
    font-size: 0.9em;
    background-color: var(--color-paper-deep);
    border-radius: 0.25rem;
    padding: 0.1em 0.3em;
  }
</style>
