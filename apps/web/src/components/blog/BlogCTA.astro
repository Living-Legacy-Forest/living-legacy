---
// A quiet call to action beside the article, pointing at the one lead-gen
// destination the rest of the site funnels through.
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
---

<aside class="border-bark/20 bg-paper-deep/60 rounded-xl border p-6">
  <p class="eyebrow">Thinking about a Living Legacy?</p>
  <h2 class="mt-3 text-xl leading-snug text-balance">Talk it through with us</h2>
  <p class="text-ink-soft mt-2 text-base leading-relaxed text-pretty">
    Ask anything about the process, the forests, or what a Living Legacy Tree involves. There is no
    obligation.
  </p>
  <a href="/contact/" class={cn(buttonVariants({ variant: 'default' }), 'mt-5 w-full')}>
    Get in touch
  </a>
</aside>
