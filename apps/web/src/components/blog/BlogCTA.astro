---
// A quiet call to action beside the article, pointing at the one lead-gen
// destination the rest of the site funnels through. No box: a thin rule above
// sets it apart without competing with the article.
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
---

<aside class="border-bark/20 border-t pt-6">
  <h2 class="text-xl leading-snug text-balance">Talk it through with us</h2>
  <p class="text-ink-soft mt-2 text-base leading-relaxed text-pretty">
    Ask anything about the process, the forests, or what a Living Legacy Tree involves. There is no
    obligation.
  </p>
  <a href="/contact/" class={cn(buttonVariants({ size: 'sm' }), 'mt-5')}> Get in touch </a>
</aside>
