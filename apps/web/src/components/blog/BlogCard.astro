---
// One post on the index, an archive, or the related-posts strip.
//
// The whole card is not a link: the title is, stretched over the card with an
// ::after so the click target covers everything while the accessibility tree
// only announces one sensible link, not one wrapping the image, the category
// and the date as one long run. The category badge sits above the stretched
// overlay (relative z-10) so it stays independently clickable.
//
// CardTitle (src/components/ui/card.tsx) renders a <div>, not a heading, and
// has no render/asChild prop to become one. Its classes are reproduced here
// directly on a real <h3> so post titles keep their place in the outline.
//
// Feel, after Apple's fluid-interface guidance:
// - The card fills its grid row and the meta line sits at the bottom, so every
//   card in a row ends level whatever the title's length.
// - Pressing the title link (i.e. anywhere on the card but the badge) gives
//   instant feedback: a 100ms scale to 0.985 on press, eased back on release.
// - Hover adds depth rather than motion for its own sake: a slight lift with a
//   deeper, softer shadow, and the photo eases in. Tailwind's `hover:` only
//   applies where the device can hover, so touch never sticks in that state.
// - Keyboard focus rings the whole card, the area the link actually covers,
//   rather than the title text alone.
// - Reduced motion keeps the shadow and focus ring but drops lift, press scale
//   and the photo zoom.
import { Card, CardHeader, CardFooter, CardDescription } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { type BlogPost, formatBlogDate } from '@/lib/blog';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, slug, excerpt, publishedAt, image, category, readingTime } = post;

const imgSrc = image?.cardUrl ?? image?.url;
---

<article class="group h-full">
  <Card
    size="sm"
    className="has-[h3_a:focus-visible]:ring-moss relative h-full pt-0 transition-[translate,scale,box-shadow] duration-300 ease-[var(--ease-grow)] hover:-translate-y-0.5 hover:shadow-[0_24px_48px_-24px_rgb(23_35_28/0.35)] has-[h3_a:active]:scale-[0.985] has-[h3_a:active]:duration-100 has-[h3_a:focus-visible]:ring-2 motion-reduce:transition-shadow motion-reduce:hover:translate-y-0 motion-reduce:has-[h3_a:active]:scale-100"
  >
    {
      /* Rendered only when there is an image: an empty frame reads as one that
        failed to load rather than as a card that never had one. */
    }
    {
      imgSrc && (
        <div class="bg-paper-deep aspect-[3/2] w-full overflow-hidden">
          <img
            src={imgSrc}
            alt={image?.alt ?? ''}
            width="800"
            height="534"
            loading="lazy"
            decoding="async"
            class="size-full object-cover transition-transform duration-500 ease-[var(--ease-grow)] group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
          />
        </div>
      )
    }

    <CardHeader className="flex-1 content-start gap-2.5">
      {
        category && (
          <a href={`/blog/category/${category.slug}/`} class="relative z-10 w-fit">
            <Badge variant="outline" className="hover:border-moss hover:text-moss-deep">
              {category.title}
            </Badge>
          </a>
        )
      }

      <h3 class="font-heading text-lg leading-snug font-normal tracking-tight text-balance">
        <a
          href={`/blog/${slug}/`}
          class="group-hover:text-moss-deep transition-colors duration-300 outline-none after:absolute after:inset-0 after:content-['']"
        >
          {title}
        </a>
      </h3>

      {excerpt && <CardDescription className="line-clamp-3 text-pretty">{excerpt}</CardDescription>}
    </CardHeader>

    <CardFooter className="text-bark flex-wrap gap-x-2 border-t-0 pt-0 text-base">
      <time datetime={publishedAt}>{formatBlogDate(publishedAt)}</time>
      {readingTime && <span aria-hidden="true">&middot;</span>}
      {readingTime && <span>{readingTime} min read</span>}
    </CardFooter>
  </Card>
</article>
