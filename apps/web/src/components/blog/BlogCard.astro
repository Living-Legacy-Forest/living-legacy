---
// One post on the index, an archive, or the related-posts strip.
//
// Deliberately plain: the photo, a small topic label, the title, two lines of
// excerpt and the date. No card frame, shadow or badge, so a grid of them
// reads as a calm list of articles rather than a wall of boxes.
//
// The whole card is not a link: the title is, stretched over the card with an
// ::after so the click target covers everything while the accessibility tree
// only announces one sensible link. The topic label sits above that overlay
// (relative z-10) so it stays independently clickable.
//
// Cards further down the page fade up as they scroll in, a row at a time with
// a short stagger (src/components/Reveal.astro).
//
// Hover is quiet on purpose: the title turns moss and the photo dims a touch.
// Nothing moves or scales. Keyboard focus rings the photo, the card's
// clearest edge, rather than the title text alone.
import { type BlogPost, formatBlogDate } from '@/lib/blog';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, slug, excerpt, publishedAt, image, category, readingTime } = post;

const imgSrc = image?.cardUrl ?? image?.url;
---

<article data-reveal class="group relative flex h-full flex-col">
  {
    /* Rendered only when there is an image: an empty frame reads as one that
      failed to load rather than as a card that never had one. */
  }
  {
    imgSrc && (
      <div class="bg-paper-deep group-has-[h3_a:focus-visible]:ring-moss mb-5 aspect-[3/2] overflow-hidden rounded-xl ring-offset-2 ring-offset-[var(--color-paper)] group-has-[h3_a:focus-visible]:ring-2">
        <img
          src={imgSrc}
          alt={image?.alt ?? ''}
          width="800"
          height="534"
          loading="lazy"
          decoding="async"
          class="size-full object-cover transition-opacity duration-300 group-hover:opacity-90 motion-reduce:transition-none"
        />
      </div>
    )
  }

  {
    category && (
      <a
        href={`/blog/category/${category.slug}/`}
        class="text-moss-deep hover:text-ink relative z-10 mb-2 w-fit text-sm font-medium transition-colors duration-200"
      >
        {category.title}
      </a>
    )
  }

  <h3 class="font-heading text-xl leading-snug font-normal tracking-tight text-balance">
    <a
      href={`/blog/${slug}/`}
      class="group-hover:text-moss-deep transition-colors duration-200 outline-none after:absolute after:inset-0 after:content-['']"
    >
      {title}
    </a>
  </h3>

  {excerpt && <p class="text-ink-soft mt-2 line-clamp-2 text-base text-pretty">{excerpt}</p>}

  <p class="text-bark mt-auto flex flex-wrap gap-x-2 pt-4 text-sm">
    <time datetime={publishedAt}>{formatBlogDate(publishedAt)}</time>
    <span aria-hidden="true">&middot;</span>
    <span>{readingTime} min read</span>
  </p>
</article>
