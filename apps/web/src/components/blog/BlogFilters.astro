---
// Search and topic filter for the blog index.
//
// A plain GET form, so every result is a shareable URL:
// /blog/?q=ashes&tag=memorial-ideas. The topic dropdown (BlogTopicSelect)
// loads a topic as soon as it is picked; the Search button keeps the current
// topic through a hidden field. "All topics" drops the topic, not the search.
import HugeIcon from '@/components/ui/HugeIcon.astro';
import { Cancel01Icon, Search01Icon } from '@hugeicons/core-free-icons';
import { BlogTopicSelect } from '@/components/blog/BlogTopicSelect';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import type { BlogTagCount } from '@/lib/blog-posts';

interface Props {
  q?: string;
  tag?: string;
  tags: BlogTagCount[];
  class?: string;
}

const { q = '', tag = '', tags, class: className } = Astro.props;

function href(params: { q?: string; tag?: string }): string {
  const search = new URLSearchParams();
  if (params.q) search.set('q', params.q);
  if (params.tag) search.set('tag', params.tag);
  const query = search.toString();
  return query ? `/blog/?${query}` : '/blog/';
}

// Editors have typed tags in mixed case ("memorial ideas", "What to do with
// cremated ashes"); the options read as one set in sentence case.
const sentenceCase = (title: string) => title.charAt(0).toUpperCase() + title.slice(1);

// The search field matches the buttons' 48px height and rounded-xl corners,
// as does the topic dropdown's trigger.
const fieldClass =
  'border-bark/25 hover:border-bark/40 focus-within:border-moss focus-within:ring-ring/20 relative flex h-12 items-center rounded-xl border bg-white transition-[border-color,box-shadow] duration-200 focus-within:ring-4';
---

<form
  action="/blog/"
  method="get"
  role="search"
  data-blog-filters
  class:list={['flex flex-col gap-3 sm:flex-row', className]}
>
  <div class={cn(fieldClass, 'pl-4 sm:max-w-md sm:flex-1')}>
    <label for="blog-search" class="sr-only">Search articles</label>
    <HugeIcon icon={Search01Icon} class="text-bark size-5 shrink-0" aria-hidden="true" />
    <input
      id="blog-search"
      type="search"
      name="q"
      value={q}
      maxlength={100}
      placeholder="Search articles"
      autocomplete="off"
      enterkeyhint="search"
      class="text-ink placeholder:text-bark/80 h-full min-w-0 flex-1 bg-transparent px-3 text-base outline-none [&::-webkit-search-cancel-button]:hidden"
    />
    {
      q && (
        <a
          href={href({ tag })}
          aria-label="Clear search"
          class="text-bark hover:text-ink focus-visible:ring-ring/30 mr-2 grid size-8 shrink-0 place-items-center rounded-lg transition-colors outline-none focus-visible:ring-2"
        >
          <HugeIcon icon={Cancel01Icon} class="size-4" aria-hidden="true" />
        </a>
      )
    }
  </div>

  <div class="flex gap-3">
    {
      tags.length > 0 && (
        <div class="min-w-0 flex-1 sm:flex-none">
          <BlogTopicSelect
            client:load
            tag={tag}
            topics={tags.map((t) => ({
              slug: t.slug,
              title: sentenceCase(t.title),
              count: t.count,
            }))}
          />
        </div>
      )
    }
    {tag && <input type="hidden" name="tag" value={tag} />}
    <button type="submit" class={cn(buttonVariants(), 'shrink-0')}> Search </button>
  </div>
</form>

<script>
  // An empty search box is left out of the URL, so a topic on its own reads
  // /blog/?tag=… rather than /blog/?q=&tag=….
  const form = document.querySelector<HTMLFormElement>('[data-blog-filters]');
  form?.addEventListener('formdata', (event) => {
    for (const key of ['q', 'tag']) {
      if (!event.formData.get(key)) event.formData.delete(key);
    }
  });
</script>
