---
// Article header: breadcrumb, category, title, byline and featured image.
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbSeparator,
} from '@/components/ui/breadcrumb';
import { type BlogPost, formatBlogDate, lastUpdatedAt } from '@/lib/blog';
import { HERO_SIZES } from '@/lib/media-srcset';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, publishedAt, category, author, image, readingTime } = post;

const heroSrc = image?.url;

// Only worth a second line when the last edit happened on a different day.
const updatedAt = lastUpdatedAt(post);
const showUpdated = new Date(updatedAt).toDateString() !== new Date(publishedAt).toDateString();
---

<header class="pt-10 pb-8 md:pt-14">
  <div class="mx-auto max-w-6xl px-6 sm:px-10">
    <Breadcrumb className="rise mb-8">
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/">Home</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbLink href="/blog/">Blog</BreadcrumbLink>
        </BreadcrumbItem>
      </BreadcrumbList>
    </Breadcrumb>

    <div class="rise-children flex max-w-3xl flex-col gap-5">
      {
        category && (
          <a
            href={`/blog/category/${category.slug}/`}
            class="text-moss-deep hover:text-ink w-fit text-sm font-medium transition-colors duration-200"
          >
            {category.title}
          </a>
        )
      }

      <h1 class="display-title text-balance">{title}</h1>

      <div class="text-bark text-base">
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
          {
            author && (
              <a
                href={`/blog/author/${author.slug}/`}
                class="text-ink hover:text-moss-deep font-medium transition-colors duration-300"
              >
                {author.name}
              </a>
            )
          }
          {author && <span aria-hidden="true">&middot;</span>}
          <time datetime={publishedAt}>{formatBlogDate(publishedAt)}</time>
          {readingTime && <span aria-hidden="true">&middot;</span>}
          {readingTime && <span>{readingTime} min read</span>}
        </div>
      </div>

      {
        showUpdated && (
          <p class="text-bark -mt-2 text-base">
            Updated <time datetime={updatedAt}>{formatBlogDate(updatedAt)}</time>
          </p>
        )
      }
    </div>
  </div>

  {
    heroSrc && (
      <div class="rise mx-auto mt-10 max-w-6xl px-6 [animation-delay:320ms] sm:px-10">
        <img
          src={heroSrc}
          srcset={image?.srcset}
          sizes={image?.srcset ? HERO_SIZES : undefined}
          alt={image?.alt ?? ''}
          style={image?.position ? `object-position: ${image.position}` : undefined}
          width={image?.width ?? 1600}
          height={image?.height ?? 900}
          fetchpriority="high"
          class="aspect-[16/9] w-full rounded-xl object-cover"
        />
      </div>
    )
  }
</header>
