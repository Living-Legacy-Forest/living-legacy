---
import HugeIcon from '@/components/ui/HugeIcon.astro';
import {
  Facebook01Icon,
  GoogleIcon,
  InstagramIcon,
  Linkedin01Icon,
  NewTwitterIcon,
  TiktokIcon,
  YoutubeIcon,
} from '@hugeicons/core-free-icons';
import BrandImage from '@/components/ui/BrandImage.astro';
import PatentsDialog from '@/components/layout/PatentsDialog';
import { Separator } from '@/components/ui/separator';
import { buttonVariants } from '@/components/ui/button';
import { trackingConfigFrom } from '@/lib/tracking-config';
import logoWordmark from '@/assets/brand/logo-wordmark.png';
import { type SocialKey, getSiteSettings, socialLinks } from '@/lib/settings';

const exploreLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/#about-section' },
  { label: 'Locations', href: '/#location-section' },
  { label: 'Contact', href: '/contact/' },
  { label: 'FAQs', href: '/faqs/' },
];

const mediaLinks = [
  { label: 'In the media', href: '/about/in-the-media/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Our partners', href: '/our-partners/' },
];

// Contact, business and social details come from the CMS Settings page.
const settings = await getSiteSettings();

const socialIcons = {
  facebookUrl: Facebook01Icon,
  instagramUrl: InstagramIcon,
  xUrl: NewTwitterIcon,
  youtubeUrl: YoutubeIcon,
  linkedinUrl: Linkedin01Icon,
  tiktokUrl: TiktokIcon,
  googleBusinessUrl: GoogleIcon,
} satisfies Record<SocialKey, unknown>;
const socials = socialLinks(settings);

const business = [
  settings.legalName,
  settings.tradingName && `trading as ${settings.tradingName}`,
  settings.abn && `ABN ${settings.abn}`,
  settings.acn && `ACN ${settings.acn}`,
]
  .filter(Boolean)
  .join(', ');

const legalLinks = [
  { label: 'Privacy', href: '/privacy/' },
  { label: 'Terms', href: '/terms-and-conditions/' },
  { label: 'Intellectual property', href: '/intellectual-property/' },
];

const year = new Date().getFullYear();
const { asksConsent } = trackingConfigFrom(settings);
---

<footer class="border-bark/20 border-t">
  <div class="mx-auto max-w-6xl px-6 py-16 sm:px-10 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <a href="/" aria-label={`${settings.siteTitle} home`}>
          <BrandImage
            src={logoWordmark}
            height="1.75rem"
            label={settings.siteTitle}
            class="text-moss-deep"
          />
        </a>
        {
          settings.tagline && (
            <p class="text-ink-soft mt-5 max-w-sm leading-relaxed">{settings.tagline}</p>
          )
        }
        {
          socials.length > 0 && (
            <ul class="mt-6 flex items-center gap-3">
              {socials.map((social) => (
                <li>
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={social.label}
                    class={buttonVariants({ variant: 'outline', size: 'icon' })}
                  >
                    <HugeIcon icon={socialIcons[social.key]} aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <nav aria-label="Explore us" class="lg:col-span-2">
        <p class="eyebrow">Explore us</p>
        <ul class="mt-5 space-y-3">
          {
            exploreLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-ink-soft hover:text-moss-deep transition-colors duration-300"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Media and community" class="lg:col-span-3">
        <p class="eyebrow">Media and community</p>
        <ul class="mt-5 space-y-3">
          {
            mediaLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-ink-soft hover:text-moss-deep transition-colors duration-300"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        settings.address && (
          <div class="lg:col-span-3">
            <p class="eyebrow">Find us</p>
            <p class="text-ink-soft mt-5 leading-relaxed whitespace-pre-line">{settings.address}</p>
          </div>
        )
      }
    </div>

    <Separator className="mt-14" />

    <div
      class="text-bark flex flex-col gap-4 pt-8 text-xs sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="space-y-1">
        {business && <p>{business}</p>}
        <p>
          {settings.siteTitle} &copy; {year}.
          <PatentsDialog client:idle />
        </p>
      </div>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-moss-deep transition-colors duration-300">
                {link.label}
              </a>
            </li>
          ))
        }
        {
          asksConsent && (
            <li>
              <button
                type="button"
                data-consent-open
                class="hover:text-moss-deep transition-colors duration-300"
              >
                Cookie settings
              </button>
            </li>
          )
        }
      </ul>
    </div>
  </div>
</footer>
