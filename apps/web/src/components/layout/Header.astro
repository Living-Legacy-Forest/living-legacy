---
import BrandImage from '@/components/ui/BrandImage.astro';
import DesktopNav from '@/components/layout/DesktopNav';
import MobileNav from '@/components/layout/MobileNav';
import logoMark from '@/assets/brand/logo-mark.webp';
import logoWordmark from '@/assets/brand/logo-wordmark.png';
import { activeAnnouncement } from '@/lib/announcements';

const announcement = await activeAnnouncement(Astro.url.pathname);

const backgroundClass = {
  moss: 'bg-moss-deep text-paper',
  ink: 'bg-ink text-paper',
  sun: 'bg-sun text-ink',
  paper: 'bg-paper-deep text-ink',
} as const;
---

{
  announcement && (
    <div class={`${backgroundClass[announcement.background]}`} data-site-chrome>
      <p class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-3 gap-y-1 px-6 py-2.5 text-center sm:px-10">
        <span class="sm:hidden">{announcement.message}</span>
        <span class="hidden sm:inline lg:hidden">
          {announcement.messageTablet || announcement.message}
        </span>
        <span class="hidden lg:inline">
          {announcement.messageDesktop || announcement.messageTablet || announcement.message}
        </span>
        {announcement.ctaLabel && announcement.ctaUrl && (
          <a
            href={announcement.ctaUrl}
            class="font-medium underline underline-offset-4 transition-colors duration-300 hover:opacity-70"
          >
            {announcement.ctaLabel}
          </a>
        )}
      </p>
    </div>
  )
}

<header
  class="border-bark/20 bg-paper/95 sticky top-0 z-40 border-b backdrop-blur"
  data-site-chrome
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-5 sm:px-10">
    <a href="/" class="flex items-center gap-3" aria-label="Living Legacy home">
      <BrandImage src={logoMark} height="2.25rem" class="text-moss-deep" />
      <BrandImage
        src={logoWordmark}
        height="1.5rem"
        label="Living Legacy"
        class="text-moss-deep hidden sm:inline-block"
      />
    </a>

    <DesktopNav client:load />
    <MobileNav client:load />
  </div>
</header>

<!-- The announcement bar and header's combined height, as --site-chrome, so a
     section can fill exactly the first screen below them (the home hero does).
     The bar wraps to two or three lines on phones, so it is measured rather
     than guessed. Inline and right after the header, so the value is set
     before the hero below it is painted. -->
<script is:inline>
  (() => {
    const parts = document.querySelectorAll('[data-site-chrome]');
    const update = () => {
      const height = [...parts].reduce((sum, el) => sum + el.offsetHeight, 0);
      document.documentElement.style.setProperty('--site-chrome', `${height}px`);
    };
    update();
    const observer = new ResizeObserver(update);
    parts.forEach((el) => observer.observe(el));
  })();
</script>
