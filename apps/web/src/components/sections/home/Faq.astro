---
/**
 * The home page's FAQs: those tagged "home" in the CMS, as accordions, with
 * FAQPage JSON-LD for these only (the full set lives at /faqs/). Hidden when
 * none are tagged.
 */
import HugeIcon from '@/components/ui/HugeIcon.astro';
import { ArrowRight02Icon } from '@hugeicons/core-free-icons';
import { buttonVariants } from '@/components/ui/button';
import { faqJsonLd, getFaqsByTag } from '@/lib/faqs';
import { cn } from '@/lib/utils';
import HomeFaq from './HomeFaq';

const faqs = await getFaqsByTag('home');
const jsonLd = faqJsonLd(faqs);
---

{
  faqs.length > 0 && (
    <section class="border-bark/20 border-t py-24 lg:py-32">
      <p data-reveal class="eyebrow">
        Questions
      </p>
      <h2 data-reveal class="section-title mt-4">
        Frequently asked questions
      </h2>

      <div data-reveal>
        <HomeFaq faqs={faqs} client:visible />
      </div>

      <a href="/faqs/" class={cn(buttonVariants({ variant: 'link' }), 'mt-10')}>
        More FAQs
        <HugeIcon icon={ArrowRight02Icon} data-icon="inline-end" aria-hidden="true" />
      </a>
    </section>
  )
}

{
  faqs.length > 0 && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  )
}
