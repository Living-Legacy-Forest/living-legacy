---
/**
 * Home hero: the editorial collage hero (Hero04). Headline and the two ways in
 * (find a location, see how it works) on the left; on the right, a family at
 * their tree with a sapling being watered tilted over its corner, on the
 * plain page background (no wash). The upcoming-locations promotion is its
 * own strip below (PromoBanner), not part of the hero.
 *
 * Rendered as static HTML with no client directive: nothing in it is
 * interactive, and the CSS entrance plays without waiting for JavaScript.
 * It fills the first screen below the header (fullHeight).
 */
import { getImage } from 'astro:assets';
import { ArrowRight02Icon } from '@hugeicons/core-free-icons';
import { Hero04 } from '@/components/ui/hero-04';
import familyAtTree from '@/assets/home/carousel-01.webp';
import wateringSapling from '@/assets/home/carousel-08.webp';

const optimise = async (src: ImageMetadata, widths: number[]) => {
  const image = await getImage({ src, widths, format: 'webp' });
  return { src: image.src, srcSet: image.srcSet.attribute };
};

const primary = await optimise(familyAtTree, [360, 517]);
const secondary = await optimise(wateringSapling, [240, 480]);
---

<Hero04
  title="Return to earth"
  titleLine2="and live on through nature"
  description="We specialise in transforming cremated ashes into living memorials by infusing them into trees, creating lasting, sustainable tributes that grow and thrive in nature."
  primaryImage={primary}
  secondaryImage={secondary}
  primaryAlt="A grandmother and her granddaughter laughing beside their Living Legacy tree"
  secondaryAlt="A couple watering a newly planted memorial sapling"
  animation="rise"
  fullHeight
  primaryCTA={{
    ctaEnabled: true,
    text: 'Find a location',
    link: '#location-section',
    iconEnd: ArrowRight02Icon,
  }}
  secondaryCTA={{
    ctaEnabled: true,
    text: 'How it works',
    link: '#how-it-works-section',
  }}
/>
