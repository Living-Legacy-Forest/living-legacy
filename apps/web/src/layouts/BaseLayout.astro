---
import '@/styles/global.css';
import PostHog from '@/components/analytics/PostHog.astro';
import Tracking from '@/components/analytics/Tracking.astro';
import ConsentBanner from '@/components/analytics/ConsentBanner.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Reveal from '@/components/Reveal.astro';
import { Toaster } from '@/components/ui/sonner';
import { isIndexableHost } from '@/lib/seo';
import { getSiteSettings, siteIconUrl, socialLinks } from '@/lib/settings';
import {
  formatPageTitle,
  organizationJsonLd,
  serializeJsonLd,
  websiteJsonLd,
  type JsonLd,
} from '@ll/content';

interface Props {
  /** The page's own title; the site title is added by the CMS title pattern. */
  title: string;
  description?: string;
  /** Force the robots meta on. Non-production hosts are always blocked regardless. */
  noindex?: boolean;
  canonical?: string;
  /** Absolute URL for og:image / twitter:image. Falls back to the CMS default share image. */
  ogImage?: string;
  /** The share card's own title and description, used as given; they default to the page's. */
  socialTitle?: string;
  socialDescription?: string;
  /** Finer directives for a page that may be indexed; ignored when it is blocked. */
  robots?: { nofollow?: boolean; nosnippet?: boolean; noimageindex?: boolean };
  /** Skips Header and Footer — for the 404 page and anything else that draws its own chrome. */
  bare?: boolean;
  /** Marks the page as an article for social cards (og:type article and its dates and topics). */
  article?: { publishedTime: string; modifiedTime?: string; section?: string; tags?: string[] };
  /** The page's own structured data. The organisation and website are added on every page. */
  jsonLd?: JsonLd[];
}

/** Every canonical URL on the site ends with a trailing slash, matching the live URLs. */
function withTrailingSlash(pathname: string): string {
  return pathname.endsWith('/') ? pathname : `${pathname}/`;
}

const settings = await getSiteSettings();
const {
  title: pageTitle,
  description = settings.seoDescription || settings.siteTitle,
  noindex,
  canonical = new URL(withTrailingSlash(Astro.url.pathname), Astro.site).toString(),
  ogImage = settings.seoImageUrl || undefined,
  socialTitle,
  socialDescription,
  robots,
  bare = false,
  article,
  jsonLd = [],
} = Astro.props;
const title = formatPageTitle(settings.titlePattern, pageTitle, settings.siteTitle);

// Anything that is not the production domain is always blocked, so preview and
// workers.dev URLs cannot be indexed. `noindex` can only add a block, never lift
// it: pages pass `noindex={page > 1}`, and a plain `false` must not switch off
// the host check. Settings can also hide the whole site (Hide from search engines).
const blockIndexing =
  noindex === true || settings.hideFromSearch || !isIndexableHost(Astro.url.host);

// Articles also let search engines show a large image preview, as Discover needs.
const robotsContent = blockIndexing
  ? 'noindex, nofollow'
  : [
      robots?.nofollow && 'nofollow',
      robots?.nosnippet && 'nosnippet',
      robots?.noimageindex && 'noimageindex',
      article && 'max-image-preview:large',
    ]
      .filter(Boolean)
      .join(', ');

// Shares point at this site even when the canonical credits a page elsewhere.
const ogUrl =
  new URL(canonical).origin === new URL(Astro.site ?? Astro.url).origin
    ? canonical
    : new URL(withTrailingSlash(Astro.url.pathname), Astro.site).toString();

const siteUrl = (Astro.site ?? Astro.url).toString();
const iconUrl = siteIconUrl(settings);
const structuredData = [
  organizationJsonLd({
    siteUrl,
    name: settings.siteTitle,
    legalName: settings.legalName,
    email: settings.contactEmail,
    telephone: settings.phone,
    address: settings.address,
    sameAs: socialLinks(settings).map((link) => link.href),
  }),
  websiteJsonLd({ siteUrl, name: settings.siteTitle, locale: settings.locale }),
  ...jsonLd,
];
---

<!doctype html>
<html lang={settings.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {robotsContent && <meta name="robots" content={robotsContent} />}
    <link rel="canonical" href={canonical} />
    {
      iconUrl ? (
        <>
          <link rel="icon" href={iconUrl} />
          <link rel="apple-touch-icon" href={iconUrl} />
        </>
      ) : (
        <>
          <link rel="icon" href="/favicon.ico" sizes="32x32" />
          <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
          <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        </>
      )
    }
    <meta name="theme-color" content="#fbf9f5" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={settings.siteTitle} />
    <meta property="og:title" content={socialTitle || title} />
    {
      (socialDescription || description) && (
        <meta property="og:description" content={socialDescription || description} />
      )
    }
    <meta property="og:url" content={ogUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedTime} />
          {article.modifiedTime && (
            <meta property="article:modified_time" content={article.modifiedTime} />
          )}
          {article.section && <meta property="article:section" content={article.section} />}
          {article.tags?.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }
    <script type="application/ld+json" is:inline set:html={serializeJsonLd(structuredData)} />
    {
      settings.googleVerification && (
        <meta name="google-site-verification" content={settings.googleVerification} />
      )
    }
    {settings.bingVerification && <meta name="msvalidate.01" content={settings.bingVerification} />}
    <PostHog />
  </head>
  <body>
    <a
      href="#main"
      class="focus:bg-ink focus:text-paper sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:px-5 focus:py-2.5 focus:text-sm focus:font-medium"
    >
      Skip to content
    </a>
    <ConsentBanner />
    <Tracking />
    <div class="grain-layer"></div>
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    <Toaster client:idle />
    <Reveal />
  </body>
</html>
