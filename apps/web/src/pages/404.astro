---
import HugeIcon from '@/components/ui/HugeIcon.astro';
import { ArrowRight02Icon } from '@hugeicons/core-free-icons';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buttonVariants } from '@/components/ui/button';
import GrowthRings from '@/components/ui/GrowthRings.astro';

Astro.response.status = 404;
---

<BaseLayout title="Page not found | Living Legacy" noindex>
  <div
    class="mx-auto flex max-w-6xl flex-col items-center px-6 py-28 text-center sm:px-10 lg:py-40"
  >
    <div class="text-moss relative mb-10 h-40 w-40" aria-hidden="true">
      <GrowthRings class="h-full w-full" />
    </div>

    <p class="eyebrow">404</p>
    <h1 class="display-title mt-5">This page is lost in the forest.</h1>
    <p class="lead mt-6 max-w-md">
      The page you're looking for might have been moved, renamed, or doesn't exist.
    </p>

    <a href="/" class:list={[buttonVariants({ size: 'lg' }), 'mt-10']}>
      Back home
      <HugeIcon icon={ArrowRight02Icon} data-icon="inline-end" aria-hidden="true" />
    </a>
  </div>
</BaseLayout>
