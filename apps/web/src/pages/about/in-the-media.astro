---
// In the media. Managed in the CMS (Media coverage) and read on each request,
// so a new article or video shows as soon as it is published.
//
// The topic filter is a shadcn ToggleGroup island (MediaFilter.tsx) that also
// renders the grid; every item is present in its server-rendered HTML
// regardless of the active filter, since the island's own initial render
// starts on "All".
import BaseLayout from '@/layouts/BaseLayout.astro';
import { MediaFilter, type MediaItem } from '@/components/sections/media/MediaFilter';
import { getMediaCoverage } from '@/lib/media-coverage';
import { getSiteSettings } from '@/lib/settings';

export const prerender = false;

const [coverage, { timeZone }] = await Promise.all([getMediaCoverage(), getSiteSettings()]);

const items: MediaItem[] = coverage.map((item) => {
  const meta = [
    item.date &&
      new Date(item.date).toLocaleDateString('en-AU', {
        timeZone,
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      }),
    item.readingMinutes && `${item.readingMinutes} min read`,
  ].filter(Boolean);
  return {
    id: item.id,
    kind: item.kind,
    title: item.title,
    source: item.source,
    category: item.category,
    excerpt: item.excerpt,
    meta: meta.length ? meta.join(' · ') : null,
    href: item.href,
    youtubeId: item.youtubeId,
    image: item.image,
    featured: item.featured,
  };
});

const title = 'In the media';
const description =
  'Explore media coverage, news features and press stories about Living Legacy and our living memorial tree initiative.';
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-6xl px-6 py-20 sm:px-10 lg:py-28">
    <p class="eyebrow">About</p>
    <h1 class="display-title mt-4">In the media</h1>

    <div class="mt-10">
      {
        items.length > 0 ? (
          <MediaFilter client:visible items={items} />
        ) : (
          <p class="text-ink-soft text-lg">Coverage will appear here soon.</p>
        )
      }
    </div>
  </div>
</BaseLayout>
