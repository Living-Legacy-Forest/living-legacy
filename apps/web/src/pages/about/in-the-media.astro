---
// In the media. Carries all 7 live items (live/out/about__in-the-media.txt),
// deduplicated: live repeats several cards further down the page as a
// second, apparently accidental pass, which is dropped here.
//
// The All/Video/News filter is a shadcn ToggleGroup island (MediaFilter.tsx)
// that also renders the grid; every item is present in its server-rendered
// HTML regardless of the active filter, since the island's own initial
// render starts on "All". Typo fixed per house style: "Tripple M" -> "Triple M".
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { MediaFilter, type MediaItem } from '@/components/sections/media/MediaFilter';
import newsTheSenior from '@/assets/media/news-the-senior.webp';
import newsHeraldSun from '@/assets/media/news-herald-sun.webp';
import newsDailyMail from '@/assets/media/news-daily-mail.webp';

type RawNewsItem = {
  type: 'news';
  title: string;
  outlet: string;
  href: string;
  thumb: ImageMetadata;
};

type RawVideoItem = {
  type: 'video';
  title: string;
  outlet: string;
  youtubeId: string;
};

const rawItems: Array<RawNewsItem | RawVideoItem> = [
  {
    type: 'news',
    title: 'How human ashes can be treated to become part of living memorials',
    outlet: 'The Senior',
    href: 'https://www.thesenior.com.au/story/8816635/how-human-ashes-can-be-treated-to-become-part-of-living-memorials/',
    thumb: newsTheSenior,
  },
  {
    type: 'video',
    title: 'Living Legacy, Western Australia',
    outlet: 'Today Tonight',
    youtubeId: '_fxvSz2XfU8',
  },
  {
    type: 'news',
    title: 'Weird science brings eternal life to Peninsula',
    outlet: 'Herald Sun',
    href: 'https://www.heraldsun.com.au/leader/south-east/funeral-cost-living-legacy-forest-opens-mornington-green/news-story/b378415dba3f734ccd9ff571442d9630',
    thumb: newsHeraldSun,
  },
  {
    type: 'video',
    title: 'Studio 10',
    outlet: 'Network 10',
    youtubeId: 'TZTP7yN7kfE',
  },
  {
    type: 'news',
    title: 'Australian scientists in Melbourne turn human cremated ashes into plant food',
    outlet: 'Daily Mail',
    href: 'https://www.dailymail.co.uk/news/article-3597861/Australian-scientists-Melbourne-turn-humans-cremated-ashes-turned-plant-food.html',
    thumb: newsDailyMail,
  },
  {
    type: 'video',
    title: 'The Project',
    outlet: 'Studio 10',
    youtubeId: 'IpvLFePdRlQ',
  },
  {
    type: 'video',
    title: 'Allan for Breakfast',
    outlet: 'Triple M',
    youtubeId: 'b_yZqCOx3EU',
  },
];

// React islands cannot use astro:assets, so every news thumbnail is
// optimised here and handed down as a plain src/width/height.
const items: MediaItem[] = await Promise.all(
  rawItems.map(async (item) => {
    if (item.type === 'video') return item;
    const optimized = await getImage({ src: item.thumb, width: 480 });
    return {
      type: 'news' as const,
      title: item.title,
      outlet: item.outlet,
      href: item.href,
      thumbSrc: optimized.src,
      thumbWidth: optimized.attributes.width as number,
      thumbHeight: optimized.attributes.height as number,
    };
  })
);

const title = 'In the media';
const description =
  'Explore media coverage, news features and press stories about Living Legacy and our living memorial tree initiative.';
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-6xl px-6 py-20 sm:px-10 lg:py-28">
    <p class="eyebrow">About</p>
    <h1 class="display-title mt-4">In the media</h1>

    <div class="mt-10">
      <MediaFilter client:visible items={items} />
    </div>
  </div>
</BaseLayout>
