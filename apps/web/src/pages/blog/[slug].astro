---
// A single post: table of contents and a call to action flank the article
// from lg, related posts sit underneath. A missing or unpublished slug
// rewrites to /404 rather than rendering an empty article.
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogCTA from '@/components/blog/BlogCTA.astro';
import BlogHero from '@/components/blog/BlogHero.astro';
import BlogShare from '@/components/blog/BlogShare.astro';
import BlogToc from '@/components/blog/BlogToc.astro';
import BlogBody from '@/components/blog/BlogBody.astro';
import RelatedPosts from '@/components/blog/RelatedPosts.astro';
import { Badge } from '@/components/ui/badge';
import { Separator } from '@/components/ui/separator';
import { type BlogPost, lastUpdatedAt } from '@/lib/blog';
import { getBlogPostBySlug, getRelatedBlogPosts } from '@/lib/blog-posts';
import { blogPostingJsonLd, breadcrumbJsonLd } from '@ll/content';

export const prerender = false;

const { slug } = Astro.params;
const post = slug ? await getBlogPostBySlug(slug) : null;

// Each source soft-fails to no posts, so an outage reads as "not found" for
// the moment it lasts rather than a 500.
if (!post) {
  return Astro.rewrite('/404');
}

const shareUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const headings = post.headings;

let related: BlogPost[] = [];
try {
  related = await getRelatedBlogPosts(post, 3);
} catch {
  related = [];
}

const seoTitle = post.seoTitle ?? post.title;
const seoDescription = post.seoDescription ?? post.excerpt ?? '';

// A smaller rendition where the source has one, so social platforms are not
// each downloading a full-resolution original.
const ogImage = post.ogImageUrl ?? post.image?.url;

const siteUrl = (Astro.site ?? Astro.url).toString();
const publishedTime = post.publishedAt;
const modifiedTime = lastUpdatedAt(post);
const section = post.categories[0]?.title;
const tags = post.tags.map((tag) => tag.title);

const jsonLd = [
  blogPostingJsonLd({
    siteUrl,
    url: shareUrl,
    headline: post.title,
    datePublished: publishedTime,
    dateModified: modifiedTime,
    description: seoDescription || undefined,
    image: ogImage,
    authorName: post.author?.name,
    section,
    keywords: tags,
  }),
  breadcrumbJsonLd([
    { name: 'Home', url: new URL('/', siteUrl).toString() },
    { name: 'Blog', url: new URL('/blog/', siteUrl).toString() },
    { name: post.title, url: shareUrl },
  ]),
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={post.canonicalUrl ?? shareUrl}
  ogImage={ogImage}
  socialTitle={post.socialTitle}
  socialDescription={post.socialDescription}
  noindex={post.noindex}
  robots={{ nofollow: post.nofollow, nosnippet: post.nosnippet, noimageindex: post.noimageindex }}
  article={{ publishedTime, modifiedTime, section, tags }}
  jsonLd={jsonLd}
>
  <!-- The article names a view timeline that the reading-progress bar,
       a sibling, follows; timeline-scope lets the bar see it. -->
  <div class="[timeline-scope:--article]">
    <div aria-hidden="true" class="reading-progress bg-moss fixed inset-x-0 top-0 z-[60] h-0.5">
    </div>
    <BlogHero post={post} />

    <div class="mx-auto max-w-6xl px-6 pt-4 pb-20 sm:px-10 md:pb-28">
      <div class="lg:grid lg:grid-cols-[12rem_minmax(0,1fr)_16rem] lg:items-start lg:gap-10">
        <!-- Both side columns stick 7rem down: clear of the 81px sticky header
             with room to breathe. Each is the grid item itself, so it can travel
             the full height of the row (the article's) while sticking. -->
        <div class="hidden lg:sticky lg:top-28 lg:block">
          <BlogToc headings={headings} />
        </div>

        <article class="mx-auto w-full max-w-[68ch] [view-timeline-name:--article]">
          <BlogToc headings={headings} variant="collapsible" class="mb-10 lg:hidden" />

          <BlogBody html={post.html} />

          <Separator className="mt-12" />
          {
            post.tags && post.tags.length > 0 && (
              <div class="mt-8 flex flex-wrap items-center gap-2">
                {post.tags.map((tag) => (
                  <a href={`/blog/tag/${tag.slug}/`}>
                    <Badge variant="secondary" className="hover:bg-sun/40">
                      #{tag.title}
                    </Badge>
                  </a>
                ))}
              </div>
            )
          }
          <BlogShare url={shareUrl} title={post.title} class="mt-8" />
        </article>

        <div class="mt-14 lg:sticky lg:top-28 lg:mt-0">
          <BlogCTA />
        </div>
      </div>
    </div>

    <RelatedPosts posts={related} />
  </div>
</BaseLayout>
