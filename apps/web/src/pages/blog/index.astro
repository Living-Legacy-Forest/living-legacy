---
// Blog index, page one. /blog/page/[page].astro handles page two onwards so
// each page is a real, bookmarkable URL rather than a query string.
//
// With ?q= (search) and/or ?tag= (topic) the same route becomes the results
// view: no featured lead, a summary line, and pagination by ?page=. Results
// are noindex with /blog/ as canonical, so search pages never compete with
// the blog itself in search engines.
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import BlogFilters from '@/components/blog/BlogFilters.astro';
import BlogPagination from '@/components/blog/BlogPagination.astro';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/ui/breadcrumb';
import { buttonVariants } from '@/components/ui/button';
import { Separator } from '@/components/ui/separator';
import { formatBlogDate } from '@/lib/blog';
import { getBlogPage, getBlogTags, searchBlogPosts, searchTerms } from '@/lib/blog-posts';

export const prerender = false;

const params = Astro.url.searchParams;
const q = (params.get('q') ?? '').trim().slice(0, 100);
const tagSlug = (params.get('tag') ?? '').trim();
// Punctuation-only input ("??") has no terms to search for, so it counts as
// no search rather than a search that matches nothing.
const searching = searchTerms(q).length > 0;
const filtering = searching || tagSlug !== '';
const requestedPage = filtering
  ? Math.max(1, Number.parseInt(params.get('page') ?? '1', 10) || 1)
  : 1;

const [{ posts, pageCount, total }, tags] = await Promise.all([
  filtering
    ? searchBlogPosts({ q: searching ? q : '', tag: tagSlug, page: requestedPage })
    : getBlogPage(1),
  getBlogTags(),
]);

if (filtering && pageCount > 0 && requestedPage > pageCount) {
  return Astro.rewrite('/404');
}

const activeTag = tags.find((t) => t.slug === tagSlug);

function resultsHref(page: number): string {
  const search = new URLSearchParams();
  if (searching) search.set('q', q);
  if (tagSlug) search.set('tag', tagSlug);
  if (page > 1) search.set('page', String(page));
  return `/blog/?${search.toString()}`;
}

// "5 articles matching “ashes” in Memorial ideas"
const plural = total === 1 ? 'article' : 'articles';
const topicLabel = activeTag
  ? activeTag.title.charAt(0).toUpperCase() + activeTag.title.slice(1)
  : tagSlug;
const summary = [
  total === 0 ? `No ${plural}` : `${total} ${plural}`,
  searching && `matching “${q}”`,
  tagSlug && `in ${topicLabel}`,
]
  .filter(Boolean)
  .join(' ');
const resultsTitle = [searching && `“${q}”`, tagSlug && topicLabel].filter(Boolean).join(', ');

// The featured lead only makes sense with a grid behind it: on a thin blog a
// single wide card above one or two small ones reads as a layout that broke,
// not as emphasis.
const showFeatured = !filtering && posts.length > 3;
const featured = showFeatured ? (posts.find((p) => p.isFeatured) ?? posts[0]) : null;
const rest = featured ? posts.filter((p) => p.id !== featured.id) : posts;
const featuredImgSrc = featured ? (featured.image?.url ?? null) : null;

const description =
  'Stories, insights, and reflections on nature, healing, remembrance, and the powerful connection between life and the forest.';
---

<BaseLayout
  title={filtering ? `${resultsTitle} | Blog` : 'Blog'}
  description={description}
  canonical={new URL('/blog/', Astro.site).toString()}
  noindex={filtering}
>
  <div class="mx-auto max-w-6xl px-6 py-16 sm:px-10 md:py-24">
    <header class="flex max-w-2xl flex-col gap-4">
      <Breadcrumb>
        <BreadcrumbList>
          <BreadcrumbItem>
            <BreadcrumbLink href="/">Home</BreadcrumbLink>
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbPage>Blog</BreadcrumbPage>
          </BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>
      <h1 class="display-title text-balance">Living Legacy blog</h1>
      <p class="lead max-w-2xl">{description}</p>
    </header>

    <BlogFilters q={searching ? q : ''} tag={tagSlug} tags={tags} class="mt-10 md:mt-12" />

    <Separator className="mt-10 md:mt-12" />
    <div class="pt-10 md:pt-12">
      {
        filtering && (
          <div class="mb-10 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
            <h2 class="text-xl text-balance">{summary}</h2>
            <a
              href="/blog/"
              class="text-moss-deep decoration-moss/40 hover:decoration-moss text-base font-medium underline underline-offset-4 transition-colors duration-200"
            >
              Clear search
            </a>
          </div>
        )
      }
      {
        filtering && posts.length === 0 ? (
          <div class="flex max-w-xl flex-col items-start gap-5">
            <p class="text-ink-soft leading-relaxed text-pretty">
              {searching
                ? 'Nothing matched. Try fewer or different words, or browse every article.'
                : 'There are no articles on this topic yet.'}
            </p>
            <a href="/blog/" class={buttonVariants({ variant: 'outline' })}>
              Browse all articles
            </a>
          </div>
        ) : posts.length === 0 ? (
          <div class="flex max-w-xl flex-col items-start gap-5">
            <h2 class="text-xl text-balance">Nothing published yet</h2>
            <p class="text-ink-soft leading-relaxed text-pretty">
              The first posts are on their way. In the meantime, get in touch with any question
              about a Living Legacy.
            </p>
            <a href="/contact/" class={buttonVariants({ variant: 'default' })}>
              Get in touch
            </a>
          </div>
        ) : (
          <div class="flex flex-col gap-16 md:gap-20">
            {featured && (
              <article
                class:list={[
                  'group relative grid gap-8 md:items-center md:gap-12',
                  featuredImgSrc && 'md:grid-cols-2',
                ]}
              >
                {featuredImgSrc && (
                  <div class="bg-paper-deep aspect-[3/2] w-full overflow-hidden rounded-lg">
                    <img
                      src={featuredImgSrc}
                      alt={featured.image?.alt ?? ''}
                      width="1200"
                      height="800"
                      fetchpriority="high"
                      class="size-full object-cover transition-transform duration-500 ease-[var(--ease-grow)] group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                    />
                  </div>
                )}

                <div class:list={['flex flex-col gap-3', !featuredImgSrc && 'max-w-3xl']}>
                  <div class="text-bark flex flex-wrap items-center gap-x-2 text-base">
                    {featured.category && (
                      <span class="text-moss-deep font-medium">{featured.category.title}</span>
                    )}
                    {featured.category && <span aria-hidden="true">&middot;</span>}
                    <time datetime={featured.publishedAt}>
                      {formatBlogDate(featured.publishedAt)}
                    </time>
                    {featured.readingTime && <span aria-hidden="true">&middot;</span>}
                    {featured.readingTime && <span>{featured.readingTime} min read</span>}
                  </div>

                  <h2 class="text-2xl leading-snug text-balance md:text-3xl">
                    <a
                      href={`/blog/${featured.slug}/`}
                      class="group-hover:text-moss-deep transition-colors duration-300 after:absolute after:inset-0 after:content-['']"
                    >
                      {featured.title}
                    </a>
                  </h2>

                  {featured.excerpt && (
                    <p class="text-ink-soft leading-relaxed text-pretty">{featured.excerpt}</p>
                  )}
                </div>
              </article>
            )}

            {rest.length > 0 && (
              <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
                {rest.map((post) => (
                  <BlogCard post={post} />
                ))}
              </div>
            )}

            <BlogPagination
              page={filtering ? requestedPage : 1}
              pageCount={pageCount}
              buildHref={(p) =>
                filtering ? resultsHref(p) : p <= 1 ? '/blog/' : `/blog/page/${p}/`
              }
            />
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>
