---
// Tag archive. Paginated via ?page=, same pattern as the category archive.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { breadcrumbJsonLd } from '@ll/content';
import BlogCard from '@/components/blog/BlogCard.astro';
import BlogPagination from '@/components/blog/BlogPagination.astro';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/ui/breadcrumb';
import { Separator } from '@/components/ui/separator';
import { getPostsByTag, getTagBySlug } from '@/lib/blog-posts';

export const prerender = false;

const { slug } = Astro.params;
const tag = slug ? await getTagBySlug(slug) : null;

if (!tag) {
  return Astro.rewrite('/404');
}

const requestedPage = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const page = Number.isInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;

const { posts, total, pageCount } = await getPostsByTag(tag.slug, page);

if (pageCount > 0 && page > pageCount) {
  return Astro.rewrite('/404');
}

const canonicalPath = `/blog/tag/${tag.slug}/`;
const siteUrl = (Astro.site ?? Astro.url).toString();
const breadcrumbs = breadcrumbJsonLd([
  { name: 'Home', url: new URL('/', siteUrl).toString() },
  { name: 'Blog', url: new URL('/blog/', siteUrl).toString() },
  { name: tag.title, url: new URL(canonicalPath, siteUrl).toString() },
]);
const description = `${total} ${total === 1 ? 'post' : 'posts'} tagged ${tag.title} on the Living Legacy blog.`;
---

<BaseLayout
  jsonLd={[breadcrumbs]}
  title={`${tag.title} | Blog`}
  description={description}
  canonical={new URL(canonicalPath, Astro.site).toString()}
  noindex={page > 1}
>
  <div class="mx-auto max-w-6xl px-6 py-16 sm:px-10 md:py-24">
    <header class="flex max-w-2xl flex-col gap-4">
      <Breadcrumb>
        <BreadcrumbList>
          <BreadcrumbItem>
            <BreadcrumbLink href="/">Home</BreadcrumbLink>
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbLink href="/blog/">Blog</BreadcrumbLink>
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbPage>{tag.title}</BreadcrumbPage>
          </BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>
      <h1 class="display-title text-balance">#{tag.title}</h1>
    </header>

    <Separator className="mt-14 md:mt-16" />
    <div class="flex flex-col gap-16 pt-14 md:gap-20 md:pt-16">
      {
        posts.length === 0 ? (
          <p class="text-ink-soft">Nothing published with this tag yet.</p>
        ) : (
          <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <BlogCard post={post} />
            ))}
          </div>
        )
      }

      <BlogPagination
        page={page}
        pageCount={pageCount}
        buildHref={(p) => (p <= 1 ? canonicalPath : `${canonicalPath}?page=${p}`)}
      />
    </div>
  </div>
</BaseLayout>
