---
// Contact. Carries the live page's form, hours and four location cards
// (live/out/contact.txt). Two fixes beyond house style:
//
// 1. The Mornington Green address's "Australi" typo -> "Australia".
// 2. The Wellington Dam "Visit Website" link, which live points at
//    https://livinglegacywellingtondam.org (missing .au) -> corrected to
//    https://livinglegacywellingtondam.org.au/.
//
// Phone numbers use the confirmed numbers rather than live's, since live's
// Mornington Green tel:+6139059495 is missing its final digit.
//
// The form itself is the ContactForm island: a shadcn Field/Input/Textarea
// form that submits straight to HubSpot, falling back to an inline Alert
// with the phone/email above if the GUID is not configured or the request
// fails (see src/components/forms/ContactForm.tsx).
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSiteSettings } from '@/lib/settings';
import { Card, CardContent } from '@/components/ui/card';
import { ContactForm } from '@/components/forms/ContactForm';
import contactFormPhoto from '@/assets/contact/contact-form-photo.webp';
import locationWellingtonDam from '@/assets/contact/location-wellington-dam.webp';
import locationMorningtonGreen from '@/assets/contact/location-mornington-green.webp';
import locationCentennialPark from '@/assets/contact/location-centennial-park.webp';
import locationMacquariePark from '@/assets/contact/location-macquarie-park.webp';

const locations = [
  {
    name: 'Wellington Dam',
    address: '1 Wellington Dam Rd, Worsley WA 6225, Australia',
    phone: '0427 096 944',
    phoneHref: 'tel:0427096944',
    website: 'https://livinglegacywellingtondam.org.au/',
    image: locationWellingtonDam,
  },
  {
    name: 'Mornington Green',
    address: '125 Tyabb-Tooradin Rd, Somerville VIC 3912, Australia',
    phone: '+61 3 9059 4959',
    phoneHref: 'tel:+61390594959',
    website: 'https://morningtongreen.com.au/',
    image: locationMorningtonGreen,
  },
  {
    name: 'Centennial Park',
    address: '760 Goodwood Rd, Pasadena SA 5042, Australia',
    phone: '+61 8 8276 6011',
    phoneHref: 'tel:+61882766011',
    website: 'https://centennialpark.org/services/memorial-gardens/living-legacy-forever-flowers/',
    image: locationCentennialPark,
  },
  {
    name: 'Macquarie Park',
    address: 'Cnr Delhi and Plassey Roads, North Ryde NSW 2113, Australia',
    phone: '1300 389 888',
    phoneHref: 'tel:1300389888',
    website:
      'https://www.metropolitanmemorialparks.com.au/resources/sustainability/living-legacy-trees-a-sustainable-memorial',
    image: locationMacquariePark,
  },
];

const settings = await getSiteSettings();
const contact = { phone: settings.phone, email: settings.contactEmail };

const title = 'Contact';
const description =
  'Get in touch with Living Legacy. Send us a message or contact one of our four locations across Australia directly.';
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-6xl px-6 py-20 sm:px-10 lg:py-28">
    <p class="eyebrow">Contact</p>
    <h1 class="display-title mt-4">Get in touch</h1>

    <div class="mt-14 grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <Card className="shadow-panel bg-white/50 p-2 sm:p-4">
          <CardContent className="flex flex-col gap-8 px-4 sm:px-6">
            <div>
              <h2 class="card-title">Send us a message</h2>
              <p class="lead mt-3">
                Complete this form and we will get back to you during work hours.
              </p>

              <div class="mt-8">
                <ContactForm contact={contact} client:visible />
              </div>
            </div>
          </CardContent>
        </Card>
      </div>

      <aside class="lg:col-span-5">
        <Card>
          <CardContent>
            <div class="border-bark/20 aspect-[16/9] overflow-hidden rounded-xl border">
              <Image src={contactFormPhoto} alt="" width={800} class="h-full w-full object-cover" />
            </div>
            <h2 class="section-title mt-6">Contact us</h2>
            <p class="card-body mt-4">
              Let us know how our team can assist you. A quick phone call is the best way to answer
              any of your questions, however, you are welcome to send a message via our contact
              form, and we will respond as soon as possible.
            </p>
            {
              settings.openingHours && (
                <>
                  <p class="card-body mt-4">We're available to respond to calls and chats from:</p>
                  <p class="text-ink mt-2 font-medium whitespace-pre-line">
                    {settings.openingHours}
                  </p>
                </>
              )
            }
          </CardContent>
        </Card>
      </aside>
    </div>

    <div class="mt-20 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        locations.map((location) => (
          <Card className="gap-0 overflow-hidden py-0">
            <Image
              src={location.image}
              alt=""
              width={400}
              class="aspect-[4/3] w-full object-cover"
            />
            <CardContent className="flex flex-1 flex-col gap-3 py-6">
              <h3 class="card-title">{location.name}</h3>
              <p class="card-body">{location.address}</p>
              <div class="mt-auto flex flex-col gap-2 pt-2 text-base font-medium">
                <a
                  href={location.phoneHref}
                  class="text-moss-deep hover:text-ink-soft underline underline-offset-4"
                >
                  Contact now
                </a>
                <a
                  href={location.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-ink-soft hover:text-moss-deep underline underline-offset-4"
                >
                  Visit website
                </a>
              </div>
            </CardContent>
          </Card>
        ))
      }
    </div>
  </div>
</BaseLayout>
