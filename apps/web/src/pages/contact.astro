---
// Contact. Carries the live page's form, hours and four location cards
// (live/out/contact.txt). Two fixes beyond house style:
//
// 1. The Mornington Green address's "Australi" typo -> "Australia".
// 2. The Wellington Dam "Visit Website" link, which live points at
//    https://livinglegacywellingtondam.org (missing .au) -> corrected to
//    https://livinglegacywellingtondam.org.au/.
//
// Phone numbers use the confirmed numbers rather than live's, since live's
// Mornington Green tel:+6139059495 is missing its final digit.
//
// The form itself is the ContactForm island: a shadcn Field/Input/Textarea
// form that submits straight to HubSpot, falling back to an inline Alert
// with the phone/email above if the GUID is not configured or the request
// fails (see src/components/forms/ContactForm.tsx).
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSiteSettings } from '@/lib/settings';
import { telHref } from '@ll/content';
import { Card, CardContent } from '@/components/ui/card';
import LocationsCarousel from '@/components/sections/contact/LocationsCarousel';
import { ContactForm } from '@/components/forms/ContactForm';
import contactFormPhoto from '@/assets/contact/contact-form-photo.webp';
import locationWellingtonDam from '@/assets/contact/location-wellington-dam.webp';
import locationMorningtonGreen from '@/assets/contact/location-mornington-green.webp';
import locationCentennialPark from '@/assets/contact/location-centennial-park.webp';
import locationMacquariePark from '@/assets/contact/location-macquarie-park.webp';

const locations = [
  {
    name: 'Wellington Dam',
    address: '1 Wellington Dam Rd, Worsley WA 6225, Australia',
    phone: '0427 096 944',
    phoneHref: 'tel:0427096944',
    website: 'https://livinglegacywellingtondam.org.au/',
    image: locationWellingtonDam,
  },
  {
    name: 'Mornington Green',
    address: '125 Tyabb-Tooradin Rd, Somerville VIC 3912, Australia',
    phone: '+61 3 9059 4959',
    phoneHref: 'tel:+61390594959',
    website: 'https://morningtongreen.com.au/',
    image: locationMorningtonGreen,
  },
  {
    name: 'Centennial Park',
    address: '760 Goodwood Rd, Pasadena SA 5042, Australia',
    phone: '+61 8 8276 6011',
    phoneHref: 'tel:+61882766011',
    website: 'https://centennialpark.org/services/memorial-gardens/living-legacy-forever-flowers/',
    image: locationCentennialPark,
  },
  {
    name: 'Macquarie Park',
    address: 'Cnr Delhi and Plassey Roads, North Ryde NSW 2113, Australia',
    phone: '1300 389 888',
    phoneHref: 'tel:1300389888',
    website:
      'https://www.metropolitanmemorialparks.com.au/resources/sustainability/living-legacy-trees-a-sustainable-memorial',
    image: locationMacquariePark,
  },
];

// The carousel is a React island, so its photos are optimised here.
const carouselLocations = await Promise.all(
  locations.map(async ({ image, ...location }) => {
    const optimised = await getImage({ src: image, width: 640 });
    return {
      ...location,
      image: {
        src: optimised.src,
        width: 640,
        height: Math.round(640 * (image.height / image.width)),
      },
    };
  })
);

const settings = await getSiteSettings();
const contact = { phone: settings.phone, email: settings.contactEmail };

const title = 'Contact';
const description =
  'Get in touch with Living Legacy. Send us a message or contact one of our four locations across Australia directly.';
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-6xl px-6 py-20 sm:px-10 lg:py-28">
    <header class="rise-children flex max-w-2xl flex-col gap-4">
      <p class="eyebrow">Contact</p>
      <h1 class="display-title">Get in touch</h1>
      <p class="lead">
        Call, email or send us a message. We will get back to you during work hours.
      </p>
    </header>

    <!-- Both boxes share the default card colour, with no shadow, so they read
         as a pair; only the form's fields are white, to show where to type. -->
    <div class="mt-14 grid items-start gap-8 lg:grid-cols-12 lg:gap-10">
      <Card className="lg:col-span-7">
        <CardContent>
          <h2 class="card-title">Send us a message</h2>
          <div class="mt-6">
            <ContactForm contact={contact} client:visible />
          </div>
        </CardContent>
      </Card>

      <Card className="lg:col-span-5">
        <CardContent className="flex flex-col gap-8">
          <Image
            src={contactFormPhoto}
            alt=""
            width={800}
            class="aspect-[16/9] w-full rounded-xl object-cover"
          />
          <div>
            <h2 class="card-title">Talk to us</h2>
            <p class="card-body mt-3">
              A quick phone call is the best way to answer your questions.
            </p>
          </div>
          <dl class="divide-bark/15 border-bark/15 divide-y border-y text-base">
            {
              settings.phone && (
                <div class="flex items-baseline justify-between gap-4 py-3.5">
                  <dt class="text-ink-soft">Phone</dt>
                  <dd>
                    <a
                      href={telHref(settings.phone)}
                      class="text-ink hover:text-moss-deep font-medium transition-colors duration-200"
                    >
                      {settings.phone}
                    </a>
                  </dd>
                </div>
              )
            }
            {
              settings.contactEmail && (
                <div class="flex items-baseline justify-between gap-4 py-3.5">
                  <dt class="text-ink-soft">Email</dt>
                  <dd class="min-w-0">
                    <a
                      href={`mailto:${settings.contactEmail}`}
                      class="text-ink hover:text-moss-deep font-medium break-all transition-colors duration-200"
                    >
                      {settings.contactEmail}
                    </a>
                  </dd>
                </div>
              )
            }
            {
              settings.mediaEmail && (
                <div class="flex items-baseline justify-between gap-4 py-3.5">
                  <dt class="text-ink-soft">Media</dt>
                  <dd class="min-w-0">
                    <a
                      href={`mailto:${settings.mediaEmail}`}
                      class="text-ink hover:text-moss-deep font-medium break-all transition-colors duration-200"
                    >
                      {settings.mediaEmail}
                    </a>
                  </dd>
                </div>
              )
            }
            {
              settings.afterHoursPhone && (
                <div class="flex items-baseline justify-between gap-4 py-3.5">
                  <dt class="text-ink-soft">After hours</dt>
                  <dd>
                    <a
                      href={telHref(settings.afterHoursPhone)}
                      class="text-ink hover:text-moss-deep font-medium transition-colors duration-200"
                    >
                      {settings.afterHoursPhone}
                    </a>
                  </dd>
                </div>
              )
            }
            {
              settings.openingHours && (
                <div class="flex items-baseline justify-between gap-4 py-3.5">
                  <dt class="text-ink-soft">Hours</dt>
                  <dd class="text-ink text-right whitespace-pre-line">{settings.openingHours}</dd>
                </div>
              )
            }
            {
              settings.postalAddress && (
                <div class="flex items-baseline justify-between gap-4 py-3.5">
                  <dt class="text-ink-soft">Post</dt>
                  <dd class="text-ink text-right whitespace-pre-line">{settings.postalAddress}</dd>
                </div>
              )
            }
          </dl>
        </CardContent>
      </Card>
    </div>

    <section class="mt-24 lg:mt-32">
      <LocationsCarousel locations={carouselLocations} client:visible />
    </section>
  </div>
</BaseLayout>
