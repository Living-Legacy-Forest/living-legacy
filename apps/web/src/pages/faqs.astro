---
// FAQs, managed in the CMS (FAQs page) and read on each request. Every
// published FAQ with a group shows here, under its group. Group anchors match
// the old live page (general-questions, the-process, protection, pricing,
// tree-selection, sustainability, locations, family-sharing), so old
// #fragment links keep landing on the right group.
//
// Questions render as a shadcn Accordion per group (FaqAccordion.tsx);
// answers stay in the server-rendered HTML via hiddenUntilFound.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buttonVariants } from '@/components/ui/button';
import { FaqAccordion } from '@/components/sections/faqs/FaqAccordion';
import { faqJsonLd, getFaqGroups } from '@/lib/faqs';

export const prerender = false;

const groups = await getFaqGroups();
const jsonLd = faqJsonLd(groups.flatMap((group) => group.faqs));

const title = 'Frequently asked questions';
const description =
  'Find answers to common questions about Living Legacy, our process of turning ashes into living memorial trees, eco-friendly memorial options, and how it works across Australia.';
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <div class="mx-auto max-w-6xl px-6 py-20 sm:px-10 lg:py-28">
    <p class="eyebrow">Support</p>
    <h1 class="display-title mt-4">Frequently asked questions</h1>
    <p class="lead mt-6 max-w-2xl">
      Answers to the questions families ask most about turning ashes into a living memorial tree,
      across both Mornington Green and Wellington Dam.
    </p>

    <div class="mt-16 grid gap-12 lg:grid-cols-12 lg:gap-10">
      <nav aria-label="FAQ groups" class="lg:col-span-3">
        <ul
          class="border-bark/20 flex gap-2 overflow-x-auto border-b pb-3 lg:sticky lg:top-24 lg:flex-col lg:gap-1 lg:border-b-0 lg:pb-0"
        >
          {
            groups.map((group) => (
              <li class="shrink-0">
                <a
                  href={`#${group.id}`}
                  class:list={[
                    buttonVariants({ variant: 'ghost', size: 'sm' }),
                    'w-full justify-start whitespace-nowrap lg:whitespace-normal',
                  ]}
                >
                  {group.navLabel}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-16 lg:col-span-9">
        {
          groups.map((group) => (
            <section id={group.id} class="scroll-mt-24">
              <h2 class="section-title">{group.heading}</h2>
              <div class="mt-6">
                <FaqAccordion client:visible group={group} />
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
