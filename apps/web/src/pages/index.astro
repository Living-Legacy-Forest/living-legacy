---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/home/Hero.astro';
import PromoBanner from '@/components/sections/home/PromoBanner.astro';
import LegacyQuote from '@/components/sections/home/LegacyQuote.astro';
import BecomeLegacy from '@/components/sections/home/BecomeLegacy.astro';
import CoreValues from '@/components/sections/home/CoreValues.astro';
import Sustainability from '@/components/sections/home/Sustainability.astro';
import PreplanCarousel from '@/components/sections/home/PreplanCarousel.astro';
import Locations from '@/components/sections/home/Locations.astro';
import SoilScience from '@/components/sections/home/SoilScience.astro';
import MediaTeaser from '@/components/sections/home/MediaTeaser.astro';
import HowItWorks from '@/components/sections/home/HowItWorks.astro';
import Faq from '@/components/sections/home/Faq.astro';

const description =
  'Return to the earth and live on through nature with Living Legacy. Our patented process transforms cremated ashes into beautiful living memorial trees, an eco-friendly alternative to traditional burial, with family memorial options available across Australia. Pre-planning is also available.';

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Living Legacy',
  legalName: 'Forest Conservation Australia Pty Ltd',
  url: 'https://livinglegacy.com.au/',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '4/349 Collins St',
    addressLocality: 'Melbourne',
    addressRegion: 'VIC',
    postalCode: '3000',
    addressCountry: 'AU',
  },
  sameAs: [
    'https://www.facebook.com/livinglegacyforest/',
    'https://www.instagram.com/living_legacy_forest/',
    'https://www.youtube.com/channel/UCA3aDohvY5Y8Hr2oviiH-gw',
  ],
};
---

<BaseLayout title="Living memorial trees in Australia | Living Legacy" description={description}>
  <!-- Full width, so its wash can run edge to edge; it sets its own column. -->
  <Hero />
  <div class="mx-auto max-w-6xl px-6 sm:px-10">
    <PromoBanner />
    <LegacyQuote />
    <BecomeLegacy />
    <CoreValues />
    <Sustainability />
    <PreplanCarousel />
    <Locations />
    <SoilScience />
    <MediaTeaser />
    <HowItWorks />
    <Faq />
  </div>
</BaseLayout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(organizationJsonLd)} />
