---
// Register interest in an upcoming location, at /locations/upcoming/. It
// was /locations/register-your-interest-for-locations-throughout-australia/
// on the old site, which redirects here (migration 0010). Carries the live
// page's short intro and its form. Option labels for "Which part of
// Australia are you located in" are copied exactly from the live form's
// rendered <select>, including "Other".
//
// "Other location" is shown, and made required, only once "Other" is
// selected; see UpcomingLocationForm.tsx.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSiteSettings } from '@/lib/settings';
import { Card, CardContent } from '@/components/ui/card';
import { UpcomingLocationForm } from '@/components/forms/UpcomingLocationForm';

const settings = await getSiteSettings();
const contact = { phone: settings.phone, email: settings.contactEmail };

const title = 'Register interest in new locations';
const description =
  'Living Legacy is coming to new locations across Australia. Register your interest and let us know which area you would like to see us in.';
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-2xl px-6 py-20 sm:px-10 lg:py-28">
    <p class="eyebrow">Upcoming locations</p>
    <h1 class="display-title mt-4">Register interest in new locations</h1>
    <p class="lead mt-5">
      Please fill out the form below to let us know your area of interest and location.
    </p>

    <!-- Same box as the contact form: the default card colour, no shadow. -->
    <Card className="mt-10">
      <CardContent>
        <UpcomingLocationForm contact={contact} client:visible />
      </CardContent>
    </Card>
  </div>
</BaseLayout>
