---
// Privacy policy. The policy text comes from the CMS (Legal pages), where
// editors change it and an admin publishes it; only the header and the
// related-locations block below the policy live here. The text was moved in
// from this file (see apps/cms/scripts/legal-pages/privacy.md), including two
// fixes made then: the contact block now has the right address, email and
// phone, and the website link points at https://livinglegacy.com.au.
//
// The related-locations block uses the home page's two location images and
// the confirmed phone numbers.
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Card, CardContent } from '@/components/ui/card';
import { Separator } from '@/components/ui/separator';
import BlogToc from '@/components/blog/BlogToc.astro';
import Prose from '@/components/Prose.astro';
import { formatLegalDate, getLegalPage } from '@/lib/legal-pages';
import locationWellingtonDam from '@/assets/home/location-wellington-dam.png';
import locationMorningtonGreen from '@/assets/home/location-mornington-green.png';

export const prerender = false;

const page = await getLegalPage('privacy');
if (!page) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '300');
}
const title = page?.title ?? 'Privacy policy';
const description = page?.description;
const headings = page?.headings ?? [];

const relatedLocations = [
  {
    name: 'Living Legacy Wellington Dam',
    address: '1 Wellington Dam Rd, Worsley WA 6225, Australia',
    phone: '0427 096 944',
    phoneHref: 'tel:0427096944',
    href: 'https://livinglegacywellingtondam.org.au/',
    image: locationWellingtonDam,
  },
  {
    name: 'Living Legacy Mornington',
    address: '125 Tyabb-Tooradin Rd, Somerville VIC 3912, Australia',
    phone: '+61 3 9059 4959',
    phoneHref: 'tel:+61390594959',
    href: 'https://morningtongreen.com.au/',
    image: locationMorningtonGreen,
  },
];
---

<BaseLayout title={title} description={description} noindex={!page}>
  <div class="mx-auto max-w-6xl px-6 py-20 sm:px-10 lg:py-28">
    <header class="rise-children max-w-3xl">
      <p class="eyebrow">Legal</p>
      <h1 class="display-title mt-4">{title}</h1>
      {
        page?.lastPublishedAt && (
          <p class="text-muted-foreground mt-4 text-sm">
            Last updated {formatLegalDate(page.lastPublishedAt)}
          </p>
        )
      }
    </header>

    <!-- Contents beside the policy from lg, as on a blog post; a collapsible
         panel above it on smaller screens. -->
    <div class="mt-14 lg:grid lg:grid-cols-[12rem_minmax(0,1fr)] lg:items-start lg:gap-16">
      <div class="hidden lg:sticky lg:top-28 lg:block">
        <BlogToc headings={headings} label="On this page" />
      </div>

      <div class="max-w-[68ch]">
        <BlogToc
          headings={headings}
          label="On this page"
          variant="collapsible"
          class="mb-10 lg:hidden"
        />
        <Prose>
          {
            page ? (
              <Fragment set:html={page.html} />
            ) : (
              <p>This page is temporarily unavailable. Please try again in a few minutes.</p>
            )
          }
        </Prose>
      </div>
    </div>

    <div class="mt-16 max-w-3xl lg:ml-[calc(12rem+4rem)]">
      <Separator className="mb-12" />
      <p class="eyebrow">Our locations</p>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {
          relatedLocations.map((location) => (
            <a href={location.href} target="_blank" rel="noopener noreferrer" class="group block">
              <Card className="hover:ring-moss py-0 transition-colors duration-200">
                <CardContent className="flex items-center gap-4 py-4">
                  <div class="h-16 w-16 shrink-0 overflow-hidden rounded-lg">
                    <Image
                      src={location.image}
                      alt=""
                      width={128}
                      class="h-full w-full object-cover"
                    />
                  </div>
                  <div>
                    <h3 class="group-hover:text-moss-deep text-base font-medium">
                      {location.name}
                    </h3>
                    <p class="text-ink-soft text-base leading-snug">{location.address}</p>
                    <p class="text-ink-soft text-base">{location.phone}</p>
                  </div>
                </CardContent>
              </Card>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
