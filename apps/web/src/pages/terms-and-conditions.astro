---
// Terms and conditions. The terms text comes from the CMS (Legal pages), where
// editors change it and an admin publishes it; the header, its lead paragraph
// and the waiver download stay here. The notes below describe where that text
// came from when it was moved in (apps/cms/scripts/legal-pages/terms-and-conditions.md).
//
// Live content here is not the site's terms at all:
// it is a standalone 2018 event page for a Wellington Dam "conservation
// zone" plot sale, kept live at this URL ever since (see
// docs/superpowers/specs/2026-09-24-live-site-rebuild.md §2, which flags it
// for client review). Carried rather than rewritten, since the client owns
// the decision on what belongs at this URL long term.
//
// The customer waiver PDF link on live (181127-customer-waiver-for-
// conservation-zone) resolves with a 301 to a real PDF; downloaded to
// public/documents/customer-waiver-for-conservation-zone.pdf and linked
// directly rather than through the old redirect.
//
// The terms themselves are now real text, transcribed word for word from
// that PDF (Waiver & Release, and the memorial tree terms and warranty), so
// they can be read on a phone, by screen readers and by search engines.
// Wording, spelling and capitals are exactly as the PDF has them, including
// its known slips (clause 2 of the waiver ends mid-sentence; "Cancellations
// made at within 21 from purchase"); fixing them is the client's call. The
// PDF's blank form fields and signature line are left to the PDF itself.
//
// The event label and the "Purchase your plot" button were removed at the
// client's request; the waiver download is the page's one action.
//
// Dropped as noise rather than content: live repeats the waiver PDF link
// and the "Purchase your plot" button a second time each further down the
// page, an about:blank map iframe with nothing to embed, a Facebook/
// Twitter/LinkedIn share widget with no working share targets without its
// original plugin, and a page-specific 2018 mini footer (address,
// copyright, social links) that would sit directly above this site's real,
// current footer and only contradict it. The Wellington Dam address block
// that followed the terms is dropped too.
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogToc from '@/components/blog/BlogToc.astro';
import Prose from '@/components/Prose.astro';
import { formatLegalDate, getLegalPage } from '@/lib/legal-pages';
import { buttonVariants } from '@/components/ui/button';

export const prerender = false;

const page = await getLegalPage('terms-and-conditions');
if (!page) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '300');
}
const title = page?.title ?? 'Terms and conditions';
const description = page?.description;

const WAIVER_PDF_HREF = '/documents/customer-waiver-for-conservation-zone.pdf';

const headings = page?.headings ?? [];
---

<BaseLayout title={title} description={description} noindex={!page}>
  <div class="mx-auto max-w-6xl px-6 py-20 sm:px-10 lg:py-28">
    <header class="rise-children max-w-3xl">
      <p class="eyebrow">Legal</p>
      <h1 class="display-title mt-4">{title}</h1>
      {
        page?.lastPublishedAt && (
          <p class="text-muted-foreground mt-4 text-sm">
            Last updated {formatLegalDate(page.lastPublishedAt)}
          </p>
        )
      }
      <p class="lead mt-6">
        All customers must agree to the standard terms and conditions and waiver to take part in
        this memorial sanctuary event. By purchasing your plot you agree to be bound by these terms
        and conditions.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={WAIVER_PDF_HREF}
          target="_blank"
          rel="noopener noreferrer"
          class={buttonVariants()}
        >
          Customer waiver PDF download
        </a>
      </div>
    </header>

    <!-- Contents beside the terms from lg, as on the privacy policy; a
         collapsible panel above them on smaller screens. -->
    <div class="mt-14 lg:grid lg:grid-cols-[12rem_minmax(0,1fr)] lg:items-start lg:gap-16">
      <div class="hidden lg:sticky lg:top-28 lg:block">
        <BlogToc headings={headings} label="On this page" />
      </div>

      <div class="max-w-[68ch]">
        <BlogToc
          headings={headings}
          label="On this page"
          variant="collapsible"
          class="mb-10 lg:hidden"
        />
        <Prose>
          {
            page ? (
              <Fragment set:html={page.html} />
            ) : (
              <p>This page is temporarily unavailable. Please try again in a few minutes.</p>
            )
          }
        </Prose>
      </div>
    </div>
  </div>
</BaseLayout>
