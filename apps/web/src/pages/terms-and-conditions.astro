---
// Terms and conditions. Live content here is not the site's terms at all:
// it is a standalone 2018 event page for a Wellington Dam "conservation
// zone" plot sale, kept live at this URL ever since (see
// docs/superpowers/specs/2026-09-24-live-site-rebuild.md §2, which flags it
// for client review). Carried rather than rewritten, since the client owns
// the decision on what belongs at this URL long term.
//
// The customer waiver PDF link on live (181127-customer-waiver-for-
// conservation-zone) resolves with a 301 to a real PDF; downloaded to
// public/documents/customer-waiver-for-conservation-zone.pdf and linked
// directly rather than through the old redirect.
//
// Dropped as noise rather than content: live repeats the waiver PDF link
// and the "Purchase your plot" button a second time each further down the
// page, an about:blank map iframe with nothing to embed, a Facebook/
// Twitter/LinkedIn share widget with no working share targets without its
// original plugin, and a page-specific 2018 mini footer (address,
// copyright, social links) that would sit directly above this site's real,
// current footer and only contradict it.
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buttonVariants } from '@/components/ui/button';
import { Separator } from '@/components/ui/separator';
import logoAnimation from '@/assets/terms/logo-animation.gif';
import waiverPhoto from '@/assets/terms/waiver-photo.jpg';

const title = 'Terms and conditions';
const description =
  'Terms and conditions and the customer waiver for the Wellington Dam Memorial Forest conservation zone.';

const WAIVER_PDF_HREF = '/documents/customer-waiver-for-conservation-zone.pdf';
const PURCHASE_PLOT_HREF = 'https://livinglegacy.com.au/wellington-legacy-sanctuary-event/';
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-3xl px-6 py-20 sm:px-10 lg:py-28">
    <header class="rise-children">
      <img src={logoAnimation.src} alt="" width="120" height="120" class="mb-6 h-24 w-24" />

      <p class="eyebrow">Wellington Dam memorial sanctuary event</p>
      <h1 class="display-title mt-4">Terms and conditions</h1>

      <p class="lead mt-6">
        All customers must agree to the standard terms and conditions and waiver to take part in
        this memorial sanctuary event. By purchasing your plot you agree to be bound by these terms
        and conditions.
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        <a href={PURCHASE_PLOT_HREF} class={buttonVariants()}>Purchase your plot</a>
        <a
          href={WAIVER_PDF_HREF}
          target="_blank"
          rel="noopener noreferrer"
          class={buttonVariants({ variant: 'outline' })}
        >
          Customer waiver PDF download
        </a>
      </div>
    </header>

    <Image
      src={waiverPhoto}
      alt=""
      width={900}
      data-reveal
      class="border-bark/20 mt-10 h-auto w-full rounded-2xl border"
    />

    <section data-reveal class="mt-16" aria-labelledby="terms-location-heading">
      <Separator className="mb-12" />
      <p class="eyebrow">Information</p>
      <h2 id="terms-location-heading" class="section-title mt-4">Wellington Dam Memorial Forest</h2>

      <dl class="divide-bark/15 border-bark/15 mt-8 divide-y border-y text-base">
        <div class="flex items-baseline justify-between gap-6 py-3.5">
          <dt class="text-ink-soft shrink-0">Address</dt>
          <dd class="text-ink text-right">
            1 Wellington Dam Road, Worsley, Western Australia, Australia
          </dd>
        </div>
      </dl>
    </section>
  </div>
</BaseLayout>
