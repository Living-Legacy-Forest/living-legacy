---
// Thank you. The one live thank-you page every form on the site now lands
// on (see docs/superpowers/specs/2026-09-24-live-site-rebuild.md §2 and
// §9): the legacy /thank-you/, /thank-you-2/, /thank-you-3/ and every other
// /thank-you-*/ variant in the sitemap 301 here instead of each keeping its
// own near-duplicate page.
//
// The default copy is the live /thank-you-contact/ page's own. An optional
// ?type= tweaks the sentence for the other two forms that land here; any
// other or missing value falls back to the default, contact, wording.
import BaseLayout from '@/layouts/BaseLayout.astro';
import HugeIcon from '@/components/ui/HugeIcon.astro';
import { ArrowRight02Icon } from '@hugeicons/core-free-icons';
import { buttonVariants } from '@/components/ui/button';
import GrowthRings from '@/components/ui/GrowthRings.astro';

const type = Astro.url.searchParams.get('type');

const copy: Record<string, string> = {
  contact:
    'Your message has been received, and one of our team members will get back to you as soon as possible.',
  partner:
    'Your partnership enquiry has been received, and one of our team members will get back to you as soon as possible.',
  interest:
    'Your interest has been registered, and one of our team members will get back to you as soon as possible.',
};

const message = copy[type ?? 'contact'] ?? copy.contact;
---

<BaseLayout title="Thank you | Living Legacy" noindex>
  <div
    class="mx-auto flex max-w-6xl flex-col items-center px-6 py-28 text-center sm:px-10 lg:py-40"
  >
    <div class="text-moss relative mb-10 h-40 w-40" aria-hidden="true">
      <GrowthRings class="h-full w-full" />
    </div>

    <p class="eyebrow">Thank you</p>
    <h1 class="display-title mt-5">Thank you</h1>
    <p class="lead mt-6 max-w-md">{message}</p>

    <a href="/" class:list={[buttonVariants(), 'mt-10']}>
      Back home
      <HugeIcon icon={ArrowRight02Icon} data-icon="inline-end" aria-hidden="true" />
    </a>
  </div>
</BaseLayout>
