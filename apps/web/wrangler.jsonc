{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "living-legacy-sites",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs, as the CMS has: errors and slow requests show in the dashboard.
  "observability": { "enabled": true },
  // The CMS's database, read for redirects (src/lib/redirects.ts). Migrations
  // live in packages/db and are applied from apps/cms.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "living-legacy-db",
      "database_id": "6c172a87-78c0-4d32-b8b6-cf57324d1197"
    }
  ],
  // The CMS owns booking rules and email; the site hands bookings to it over this
  // binding (src/lib/cms-internal.ts), never over the public internet.
  "services": [{ "binding": "CMS", "service": "living-legacy-cms" }],
  // Caps bookings per visitor: 5 a minute (src/pages/api/events/book.ts).
  "ratelimits": [
    { "name": "BOOKING_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
