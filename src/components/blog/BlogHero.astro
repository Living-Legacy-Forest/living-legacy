---
// Article header: breadcrumb, category, title, byline and featured image.
import BlogShare from '@/components/blog/BlogShare.astro';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/ui/breadcrumb';
import { formatBlogDate } from '@/lib/blog';
import { imageDimensions, imageUrl } from '@/lib/sanity';
import type { SanityBlogPost } from '@/types';

interface Props {
  post: SanityBlogPost;
  shareUrl: string;
}

const { post, shareUrl } = Astro.props;
const { title, publishedAt, updatedAt, category, author, featuredImage, readingTime } = post;

const heroSrc = imageUrl(featuredImage, { width: 1600, fit: 'max' });
const heroDim = imageDimensions(featuredImage?.asset?._ref);

// Only worth a second line when the edit happened on a different day.
const showUpdated = Boolean(
  updatedAt && new Date(updatedAt).toDateString() !== new Date(publishedAt).toDateString()
);
---

<header class="pt-10 pb-8 md:pt-14">
  <div class="mx-auto max-w-6xl px-6 sm:px-10">
    <Breadcrumb className="mb-8">
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/">Home</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbLink href="/blog/">Blog</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>{title}</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </Breadcrumb>

    <div class="flex max-w-3xl flex-col gap-5">
      {
        category && (
          <a href={`/blog/category/${category.slug.current}/`} class="eyebrow text-moss-deep">
            {category.title}
          </a>
        )
      }

      <h1 class="display-title text-balance">{title}</h1>

      <div class="text-bark flex flex-wrap items-center gap-x-3 gap-y-2 text-base">
        {
          author && (
            <span
              aria-hidden="true"
              class="bg-moss text-paper flex size-10 items-center justify-center rounded-full text-base font-semibold"
            >
              {author.name.charAt(0)}
            </span>
          )
        }
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
          {
            author && (
              <a
                href={`/blog/author/${author.slug.current}/`}
                class="text-ink hover:text-moss-deep font-medium transition-colors duration-300"
              >
                {author.name}
              </a>
            )
          }
          {author && <span aria-hidden="true">&middot;</span>}
          <time datetime={publishedAt}>{formatBlogDate(publishedAt)}</time>
          {readingTime && <span aria-hidden="true">&middot;</span>}
          {readingTime && <span>{readingTime} min read</span>}
        </div>
      </div>

      {
        showUpdated && updatedAt && (
          <p class="text-bark -mt-2 text-base">
            Updated <time datetime={updatedAt}>{formatBlogDate(updatedAt)}</time>
          </p>
        )
      }

      <BlogShare url={shareUrl} title={title} class="mt-1" />
    </div>
  </div>

  {
    heroSrc && (
      <div class="mx-auto mt-10 max-w-6xl px-6 sm:px-10">
        <img
          src={heroSrc}
          alt={featuredImage?.alt ?? ''}
          width={heroDim?.width ?? 1600}
          height={heroDim?.height ?? 900}
          fetchpriority="high"
          class="aspect-[16/9] w-full rounded-xl object-cover"
        />
      </div>
    )
  }
</header>
