---
// Share links: plain anchors to each network's share endpoint rather than
// their SDKs, so nothing third-party loads and nothing is tracked before
// someone chooses to share. The copy-link button is the only part that needs
// JS, and it degrades to a keyboard hint if the clipboard is unavailable.
import { Facebook, Linkedin, Link2 } from 'lucide-astro';
import { buttonVariants } from '@/components/ui/button';

interface Props {
  url: string;
  title: string;
  class?: string;
}

const { url, title, class: className } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const iconButton = buttonVariants({ variant: 'outline', size: 'icon-sm' });
---

<div class:list={['flex items-center gap-2', className]}>
  <span class="text-bark text-base">Share</span>
  <a
    href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on Facebook"
    class={iconButton}
  >
    <Facebook aria-hidden="true" />
  </a>
  <a
    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on LinkedIn"
    class={iconButton}
  >
    <Linkedin aria-hidden="true" />
  </a>
  <a
    href={`mailto:?subject=${encodedTitle}&body=${encodedUrl}`}
    aria-label="Share by email"
    class={iconButton}
  >
    <Link2 class="rotate-45" aria-hidden="true" />
  </a>
  <button
    type="button"
    data-copy-link={url}
    aria-label="Copy link to this article"
    class={iconButton}
  >
    <Link2 aria-hidden="true" />
  </button>
  <span data-copy-status role="status" aria-live="polite" class="text-moss-deep text-base"></span>
</div>

<script>
  function initCopyLink(): void {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
      if (btn.dataset.copyInit === 'true') return;
      btn.dataset.copyInit = 'true';

      btn.addEventListener('click', async () => {
        const url = btn.dataset.copyLink ?? '';
        const status = btn.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
        try {
          await navigator.clipboard.writeText(url);
          if (status) {
            status.textContent = 'Link copied';
            setTimeout(() => {
              status.textContent = '';
            }, 2400);
          }
        } catch {
          // Clipboard access can be refused outright, on an insecure origin
          // or by permission. Saying nothing would read as a dead button.
          if (status) status.textContent = 'Press Ctrl+C to copy';
        }
      });
    });
  }

  initCopyLink();
  document.addEventListener('astro:after-swap', initCopyLink);
</script>
