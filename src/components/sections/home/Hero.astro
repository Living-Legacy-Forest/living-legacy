---
/**
 * Home hero. Headline and the two ways in (find a location, see how it
 * works) on the left; on the right, a family at their tree, set in an arch
 * inside the growth rings. The upcoming-locations promotion is its own strip
 * below (PromoBanner), not part of the hero.
 */
import { Image } from 'astro:assets';
import { ArrowRight } from 'lucide-astro';
import GrowthRings from '@/components/ui/GrowthRings.astro';
import { buttonVariants } from '@/components/ui/button';
import familyAtTree from '@/assets/home/carousel-01.webp';
import wateringSapling from '@/assets/home/carousel-08.webp';
---

<section
  class="relative isolate grid items-center gap-14 pt-10 pb-16 lg:grid-cols-12 lg:gap-10 lg:pt-20 lg:pb-24"
>
  <div class="lg:col-span-7">
    <p class="eyebrow rise" style="animation-delay:.05s">Living memorial trees in Australia</p>

    <h1 class="display-title rise mt-6" style="animation-delay:.12s">
      Return to earth and live on through nature
    </h1>

    <p class="lead rise mt-7 max-w-xl" style="animation-delay:.22s">
      We specialise in transforming cremated ashes into living memorials by infusing them into
      trees, creating lasting, sustainable tributes that grow and thrive in nature.
    </p>

    <div
      class="rise mt-10 flex flex-wrap items-center gap-x-8 gap-y-4"
      style="animation-delay:.32s"
    >
      <a href="#location-section" class={buttonVariants()}>
        Find a location
        <ArrowRight data-icon="inline-end" aria-hidden="true" />
      </a>
      <a
        href="#how-it-works-section"
        class="text-ink-soft decoration-bark/40 hover:text-moss-deep hover:decoration-moss text-base font-medium underline underline-offset-4 transition-colors duration-200"
      >
        How it works
      </a>
    </div>

    <p
      class="rise text-bark border-bark/20 mt-12 max-w-md border-t pt-6 text-xs leading-relaxed"
      style="animation-delay:.42s"
    >
      The Living Legacy process is patented in Australia, the United States and the United Kingdom.
    </p>
  </div>

  <!-- The photograph, arched like a canopy, inside the growth rings. -->
  <div
    class="rise relative mx-auto w-full max-w-sm lg:col-span-5 lg:max-w-none"
    style="animation-delay:.2s"
  >
    <div
      class="text-moss pointer-events-none absolute top-1/2 left-1/2 -z-10 w-[165%] -translate-x-1/2 -translate-y-1/2"
      aria-hidden="true"
    >
      <GrowthRings class="h-auto w-full" />
    </div>

    <div class="relative mx-auto w-[82%]">
      <Image
        src={familyAtTree}
        alt="A grandmother and her granddaughter laughing beside their Living Legacy tree"
        widths={[360, 517]}
        sizes="(min-width: 1024px) 360px, 80vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/5] w-full rounded-t-full rounded-b-3xl object-cover shadow-[0_30px_60px_-30px_rgb(23_35_28/0.55)]"
      />

      <Image
        src={wateringSapling}
        alt="A couple watering a newly planted memorial sapling"
        width={240}
        loading="eager"
        class="border-paper absolute -bottom-8 -left-10 aspect-square w-[42%] rounded-2xl border-4 object-cover shadow-[0_20px_40px_-20px_rgb(23_35_28/0.6)] sm:-left-14"
      />
    </div>
  </div>
</section>
