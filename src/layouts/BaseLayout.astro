---
import '@/styles/global.css';
import PostHog from '@/components/analytics/PostHog.astro';
import { isIndexableHost } from '@/lib/seo';

interface Props {
  title: string;
  description?: string;
  /** Force the robots meta on. Left unset, it follows the request host. */
  noindex?: boolean;
  canonical?: string;
}

const {
  title,
  description = 'Living Legacy Forest',
  noindex,
  canonical = new URL(Astro.url.pathname, Astro.site).toString(),
} = Astro.props;

// Anything that is not the production domain is blocked, so preview and
// workers.dev URLs cannot be indexed. A page may still opt in explicitly.
const blockIndexing = noindex ?? !isIndexableHost(Astro.url.host);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {blockIndexing && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f6f2e9" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Living Legacy Forest" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <PostHog />
  </head>
  <body>
    <slot />
  </body>
</html>
